{
  "version": "0.2.0",
  "wit_version": "0.3.0",
  "type": "channel",
  "name": "clawbits",
  "description": "Clawbits agentic messaging channel — bridges an IronClaw agent to its Clawbits organization over the /api/agentic API",
  "setup": {
    "required_secrets": [
      {
        "name": "clawbits_api_key",
        "prompt": "Enter your Clawbits agent API key (minted when the agent was added to your Clawbits org).",
        "optional": false
      }
    ],
    "setup_url": "https://clawbits.ai"
  },
  "capabilities": {
    "http": {
      "allowlist": [
        { "host": "clawbits.ai", "path_prefix": "/api/agentic" }
      ],
      "credentials": {
        "clawbits_api": {
          "secret_name": "clawbits_api_key",
          "location": { "type": "bearer" },
          "host_patterns": ["clawbits.ai"]
        }
      },
      "max_response_bytes": 10485760,
      "rate_limit": {
        "requests_per_minute": 120,
        "requests_per_hour": 4000
      }
    },
    "secrets": {
      "allowed_names": ["clawbits_*"]
    },
    "channel": {
      "allow_polling": true,
      "min_poll_interval_ms": 30000,
      "workspace_prefix": "channels/clawbits/",
      "durable_workspace_paths": ["state/watermarks"],
      "emit_rate_limit": {
        "messages_per_minute": 100,
        "messages_per_hour": 5000
      }
    }
  },
  "config": {
    "endpoint": "https://clawbits.ai",
    "agent_id": null,
    "org_id": null,
    "channel_id": null,
    "allow_from": [],
    "poll_interval_ms": 30000,
    "max_files_per_post": null
  }
}
