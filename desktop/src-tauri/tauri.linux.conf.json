{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "clawbits",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "clawbits",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "transparent": false,
        "decorations": true
      }
    ],
    "macOSPrivateApi": false
  },
  "bundle": {
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1",
          "libnotify4"
        ],
        "desktopTemplate": "clawbits.desktop",
        "section": "net"
      }
    }
  }
}
