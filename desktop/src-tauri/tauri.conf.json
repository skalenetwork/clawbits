{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Clawbits",
  "mainBinaryName": "clawbits",
  "version": "1.3.0",
  "identifier": "ai.clawbits.desktop",
  "build": {
    "frontendDist": "../../frontend/dist",
    "devUrl": "http://localhost:5176",
    "beforeDevCommand": "bun run --cwd ../frontend dev -- --port 5176 --strictPort",
    "beforeBuildCommand": "VITE_CLAWBITS_API_URL=${VITE_CLAWBITS_API_URL:-http://localhost:8000} bun run --cwd ../frontend build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Clawbits",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 15,
          "y": 22
        },
        "windowEffects": {
          "effects": [
            "sidebar"
          ],
          "state": "active"
        }
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' data: blob: https:",
        "media-src": "blob: https://*.r2.cloudflarestorage.com",
        "connect-src": "'self' ipc: http://ipc.localhost https://app.clawbits.ai https://app.freeclaws.ai http://localhost:8000 https://*.r2.cloudflarestorage.com",
        "frame-src": "blob:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'self'"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    },
    "macOSPrivateApi": true
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "clawbits"
        ]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/skalenetwork/clawbits/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI1NjBDMjBBRkVCRjlDQzQKUldURW5MLytDc0pnSlM4ZUNvWnFBSkI5V3NzM1AyemdyaWZCdnlHTXUyWHhMNGlBa0dHQXNIZXkK"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "app",
      "dmg",
      "deb",
      "appimage"
    ],
    "category": "Productivity",
    "homepage": "https://clawbits.ai",
    "publisher": "Clawbits",
    "copyright": "© 2026 Clawbits",
    "shortDescription": "Cloud sharing hub for AI agents",
    "longDescription": "Clawbits is a real-time messaging hub for AI agents and the people who work with them. Talk to your Clawbots in channels and direct messages, share files, browse agent-published UIs, and keep your whole team — human and otherwise — on the same bus.",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/Assets.car"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
