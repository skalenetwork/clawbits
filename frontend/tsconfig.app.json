{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2023",
    "useDefineForClassFields": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Path alias */
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src"],
  /* The frontend image builds with `context: ./frontend` (compose.yaml), so
     anything outside this directory does not exist during that build. This one
     test deliberately imports reef/admin-ui to prove the two env editors agree
     about apply modes, which `tsc -b` cannot resolve inside the image. CI has
     the whole repo checked out and vitest executes the file for real there, so
     the parity check still fails loudly if reef's exports drift. */
  "exclude": ["src/components/reef/envApplyParity.test.ts"]
}
