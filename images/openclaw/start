#!/bin/sh
set -e

[ "$(id -u)" = 0 ] && as_node="/usr/bin/setpriv --reuid=node --regid=node --init-groups --"

house="${OPENCLAW_WORKSPACE_DIR:-/home/node/.openclaw/workspace}/.clawbits"

if [ "$(id -u)" = 0 ]; then
  install -d -o node -g node /home/node/.openclaw /home/node/.openclaw/state "$house"
  install -o node -g node -m 0644 /usr/local/share/clawbits-soul.md "$house/SOUL.md"
else
  mkdir -p /home/node/.openclaw/state "$house"
  cp /usr/local/share/clawbits-soul.md "$house/SOUL.md"
fi
[ -s "$OPENCLAW_CONFIG_PATH" ] || rm -f "$OPENCLAW_CONFIG_PATH"

gateway_token=/home/node/.openclaw/state/gateway-token
if [ -z "${OPENCLAW_GATEWAY_TOKEN:-}" ]; then
  if [ ! -s "$gateway_token" ]; then
    (umask 077; od -An -N32 -tx1 /dev/urandom | tr -d ' \n' > "$gateway_token")
    if [ "$(id -u)" = 0 ]; then chown node:node "$gateway_token"; fi
  fi
  OPENCLAW_GATEWAY_TOKEN="$(cat "$gateway_token")"
  export OPENCLAW_GATEWAY_TOKEN
fi

engine=/home/node/.openclaw/state/engine-build.json
if [ "$(cat /app/dist/build-info.json)" != "$(cat "$engine" 2>/dev/null)" ]; then
  if [ ! -e /home/node/.openclaw/state/openclaw.sqlite ] ||
    $as_node /usr/local/bin/node --disable-warning=ExperimentalWarning /app/openclaw.mjs doctor --fix >/dev/null 2>&1; then
    $as_node cp /app/dist/build-info.json "$engine"
  fi
fi

log=/home/node/.openclaw/state/boot.log
if ! $as_node /usr/local/bin/node /usr/local/share/clawbits-boot.ts 2>>"$log"; then
  echo "clawbits-start: could not write the clawbits config; last error in $log" >&2
  tail -n 20 "$log" >&2 || true
  exit 1
fi

exec $as_node /usr/local/bin/node /app/openclaw.mjs gateway --bind lan --auth token
