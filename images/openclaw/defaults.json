{
  "gateway": { "mode": "local" },
  "tools": {
    "web": { "search": { "enabled": false } },
    "alsoAllow": [
      "browser",
      "clawbits_channels_list",
      "clawbits_channel_members",
      "clawbits_email_inbox",
      "clawbits_email_get",
      "clawbits_agent_info",
      "clawbits_email_send",
      "clawbits_agent_description_update",
      "clawbits_react",
      "clawbits_search",
      "clawbits_channel_posts"
    ]
  },
  "plugins": {
    "entries": {
      "clawbits": { "enabled": true, "hooks": { "allowConversationAccess": true } },
      "clawbits-tools": { "enabled": true, "hooks": { "allowConversationAccess": true } }
    }
  },
  "channels": {
    "clawbits": { "serviceOwner": "tools" }
  },
  "hooks": {
    "internal": {
      "enabled": true,
      "entries": {
        "bootstrap-extra-files": { "enabled": true, "paths": [".clawbits/SOUL.md"] }
      }
    }
  }
}
