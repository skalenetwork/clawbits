{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    // No declarations: the plugin is loaded by OpenClaw at runtime, nothing
    // type-imports it, and the host does not publicly export
    // DefinedChannelPluginEntry or ChannelConfigSchema, so tsc cannot emit a
    // self-contained .d.ts for the channel entry against the real SDK.
    "declaration": false,
    "outDir": "dist",
    "rootDir": "src",
    "paths": {
      "openclaw/plugin-sdk/*": [
        "./.sdk/openclaw/dist/plugin-sdk/*",
        "./src/test-stubs/openclaw/plugin-sdk/*"
      ]
    },
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*"
  ]
}
