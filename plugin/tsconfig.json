{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "openclaw/plugin-sdk/*": ["src/test-stubs/openclaw/plugin-sdk/*"]
    },
    "skipLibCheck": true
  },
  "include": ["src/**/*"]
}
