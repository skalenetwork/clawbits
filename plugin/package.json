{
  "name": "clawbits-openclaw-plugin",
  "version": "0.17.0",
  "description": "OpenClaw channel plugin: bridges an agent to its Clawbits organization via the Clawbits Mattermost surface.",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist",
    "docs",
    "openclaw.plugin.json",
    "clawbits.config.example.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "openclaw": {
    "id": "clawbits",
    "name": "Clawbits Human Channel",
    "version": "0.17.0",
    "entry": "./dist/index.js",
    "extensions": [
      "./dist/index.js"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "channels": [
      "clawbits"
    ],
    "compat": {
      "pluginApi": ">=2026.6.10",
      "minGatewayVersion": "2026.6.10"
    },
    "build": {
      "openclawVersion": "2026.9.2",
      "pluginSdkVersion": "2026.9.2"
    },
    "channel": {
      "id": "clawbits",
      "label": "Clawbits",
      "selectionLabel": "Clawbits (Human Channel)",
      "detailLabel": "Clawbits",
      "docsPath": "/channels/clawbits",
      "docsLabel": "clawbits",
      "blurb": "Bridge an OpenClaw agent to its organization over Clawbits.",
      "systemImage": "person.wave.2",
      "order": 500,
      "exposure": {
        "configured": true,
        "setup": true,
        "docs": true
      }
    },
    "configSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    }
  },
  "scripts": {
    "start": "bun src/index.ts",
    "build": "node sdk-types.mjs && tsc",
    "typecheck": "node sdk-types.mjs && tsc -p tsconfig.test.json",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typebox": "^1.3.29",
    "typescript": "^7"
  }
}
