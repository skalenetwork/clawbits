# Reef production config. Copy to /etc/reef/reef.env (chmod 0640, owned by the
# reef service user) and edit. Every value is optional unless noted; these are the
# production-relevant ones. Full list: the module docstring in reef/api/app.py.

# ── Runtime (the VMM Reef drives) ─────────────────────────────────────────────
REEF_RUNTIME=microsandbox          # microsandbox (Linux/KVM, prod) | docker (dev)
# REEF_MSB_BIN=/usr/local/bin/msb  # pin the msb binary (else PATH / ~/.microsandbox)
# REEF_DOCKER_BIN=/usr/bin/docker  # if REEF_RUNTIME=docker

# ── Durable state (the desired-state + restart-policy source of truth) ────────
# Keep this on managed storage and BACK IT UP (see reef-db-backup.*). /var/lib/reef
# is created by the systemd unit's StateDirectory=.
REEF_STATE_DIR=/var/lib/reef
REEF_DB_PATH=/var/lib/reef/reef.db
# REEF_STORE=sqlite                # sqlite (default, durable) | memory (ephemeral)

# ── API bind (keep private; front it with the proxy / Cloudflare Access) ──────
REEF_API_HOST=127.0.0.1
REEF_API_PORT=8787

# ── Auth — set at least ONE for any reachable deployment (open if neither set) ─
# REEF_ADMIN_TOKEN — the bearer token the clawbits browser session sends to manage
# the fleet (entered there each session, shared per reef, never stored by clawbits).
# Also covers the clawbits→reef machine path. The installer generates one.
# REEF_ADMIN_TOKEN=change-me
# REEF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com   # operator SSO (optional)
# REEF_ACCESS_AUD=<access-application-aud-tag>
# Browser origins allowed to call this API over your tunnel. The default already
# includes https://app.clawbits.ai — set only to add or replace it.
# REEF_CORS_ORIGINS=https://app.clawbits.ai

# ── Connect to a clawbits org (Settings → Reef) ───────────────────────────────
# You paste TWO things into clawbits: this API's public URL, and the admin token.
#   • Token: REEF_ADMIN_TOKEN above (installs: sudo grep REEF_ADMIN_TOKEN /etc/reef/reef.env).
#   • URL  : the public hostname your tunnel maps to this API. Reef doesn't run the
#            tunnel — get the URL from your tunnel (e.g. `cloudflared tunnel --url
#            http://127.0.0.1:8787` prints a https://…trycloudflare.com URL). Set it
#            here and reef echoes it in the startup "connect to clawbits" banner.
# REQUIRED for any reachable deployment: agent Control-UI / web-terminal links
# (/s/{digest}/) are built on THIS origin. Unset, they fall back to the request
# origin and can degrade to http://127.0.0.1 over a tunnel (mixed-content-blocked,
# links won't open). Set it to the exact tunnel hostname, https, no trailing path.
# REEF_PUBLIC_URL=https://reef.yourhost.com

# ── Surface-path secret - unguessable agent Control-UI / web-terminal URLs ────
# Seeds the digest in every agent surface URL: the API's /s/{digest}/ proxy
# (any reachable deployment) and the nginx subdomain proxy (when enabled).
# Unset, surface paths are derivable from sandbox ids and only each agent's
# one-time access password protects them - so set this on any reachable
# deployment. The installer generates one. Rotating it changes every agent's
# surface URLs (old links go stale); access passwords are unaffected (those
# are one-time random at creation - never derived from this, never stored).
# REEF_SUBDOMAIN_SECRET=change-me

# ── AI provider keys (forwarded into agent VMs) ───────────────────────────────
# Maintainer-level model keys. When set, reef injects them into agent VMs at
# CREATE time. The create request's `provider` field ("anthropic" | "openai" |
# "none") narrows the forwarding to one provider; requests that omit it get
# every configured key. A key passed in the create request always wins over
# these. Values never leave the host via the API - clawbits and the dashboard
# only learn WHICH providers are configured (GET /providers, admin-gated).
# Rotation: a VM's env is fixed at create, so a new key here (+ service
# restart) applies to NEW agents only - recreate an agent to move it over.
# Prefer scoped / spend-limited keys: any VM that received a key can read it.
# REEF_ANTHROPIC_API_KEY=sk-ant-...
# REEF_OPENAI_API_KEY=sk-...
# REEF_GEMINI_API_KEY=AIza...
# REEF_NEARAI_API_KEY=...
# REEF_OPENROUTER_API_KEY=sk-or-...

# ── Operator dashboard (reef-admin-ui) — LOCAL-ONLY ───────────────────────────
# A separate service (reef-admin-ui.service) serves the admin-ui SPA and proxies
# /api -> this API. It binds LOOPBACK on purpose and is reached over an SSH
# forward — NEVER put REEF_ADMIN_UI_PORT on your tunnel. The admin token still
# gates all data. install.sh builds the SPA in place with bun and enables the
# unit; no workstation build or rsync is needed.
# Reach it:  ssh -L 8788:127.0.0.1:8788 <host>  →  http://localhost:8788
# REEF_ADMIN_UI_HOST=127.0.0.1        # loopback; a LAN bind is opt-in + still off-tunnel
# REEF_ADMIN_UI_PORT=8788
# REEF_ADMIN_UI_DIR=/opt/reef/reef/admin-ui/dist   # default; override for an out-of-tree dist

# ── Self-healing reconciler ───────────────────────────────────────────────────
# IMPORTANT: run the reconciler on EXACTLY ONE node (set =1 here). If you ever run
# more than one API process against the same fleet, set =0 on the others — two
# reconcilers would fight (double restarts).
REEF_RECONCILE=1
REEF_RECONCILE_INTERVAL=15          # seconds between passes
REEF_RESTART_BACKOFF_BASE=10        # crash-loop backoff: first delay, doubles each retry
REEF_RESTART_BACKOFF_CAP=300        # …capped here
REEF_RESTART_STABLE_RESET=300       # seconds running before the restart counter resets

# ── Web-UI exposure (subdomain proxy) — only if you expose agent Control UIs ──
# REEF_BASE_DOMAIN is YOUR tunnel's wildcard domain (e.g. a Cloudflare tunnel for
# *.reef.yourhost.com). Each agent's Control UI / terminal is minted as a
# subdomain under it; the API itself rides the same tunnel (point a hostname at
# 127.0.0.1:REEF_API_PORT) — that API URL is what you paste into clawbits.
# REEF_BASE_DOMAIN=reef.yourhost.com
# REEF_NGINX_DIR=/etc/nginx/reef.d   # the service user needs write here + nginx reload
# (REEF_SUBDOMAIN_SECRET above seeds the per-agent subdomain digests too)

# ── Misc ──────────────────────────────────────────────────────────────────────
# systemd's EnvironmentFile takes the value to end-of-line — it does NOT strip
# inline '#' comments, so keep notes on their own line, never after a value.
# reconciler heals log at INFO → journald
REEF_LOG_LEVEL=INFO
# REEF_VERSION_CHECK=1              # '0' disables outbound "latest version" checks
# REEF_CLAWBITS_URL=https://app.clawbits.ai

# ── DB backup (used by reef-db-backup.sh) ─────────────────────────────────────
# REEF_BACKUP_DIR=/var/backups/reef
# REEF_BACKUP_KEEP=14
