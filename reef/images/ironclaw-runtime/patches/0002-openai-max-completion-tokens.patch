+
+    /// Drop `max_tokens` for OpenAI models that reject it (gpt-5 family /
+    /// o-series — they require `max_completion_tokens`). rig-core only serializes
+    /// `max_tokens` and omits it when `None`, so nulling it here avoids the HTTP
+    /// 400 "Unsupported parameter: 'max_tokens'"; OpenAI then applies its own
+    /// default completion cap. Models that still accept `max_tokens` are
+    /// untouched.
+    fn drop_max_tokens_if_completion_only(&self, max_tokens: &mut Option<u32>) {
+        if max_tokens.is_some()
+            && crate::reasoning_models::requires_max_completion_tokens(&self.model_name)
+        {
+            *max_tokens = None;
+        }
     }
 }
 
