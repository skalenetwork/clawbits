+    #[test]
+    fn test_gpt5_model_drops_max_tokens_without_explicit_config() {
+        // A gpt-5 / o-series model rejects `max_tokens` (needs
+        // `max_completion_tokens`). The adapter must drop it purely from the
+        // model name — no with_unsupported_params needed — for both the plain
+        // completion and tool-call paths. Legacy models keep max_tokens.
+        use rig::client::CompletionClient;
+        use rig::providers::openai;
+
+        let client: openai::Client = openai::Client::builder()
+            .api_key("test-key")
+            .base_url("http://localhost:0")
+            .build()
+            .unwrap();
+        let client = client.completions_api();
+
+        // gpt-5-mini: max_tokens is dropped (completion + tool paths).
+        let g5 = client.completion_model("gpt-5-mini");
+        let adapter = RigAdapter::new(g5, "gpt-5-mini");
+        let mut req = CompletionRequest::new(vec![ChatMessage::user("hi")]);
+        req.max_tokens = Some(100);
+        adapter.strip_unsupported_completion_params(&mut req);
+        assert!(req.max_tokens.is_none(), "gpt-5 must drop max_tokens");
+
+        let mut treq = ToolCompletionRequest::new(vec![ChatMessage::user("hi")], vec![]);
+        treq.max_tokens = Some(100);
+        adapter.strip_unsupported_tool_params(&mut treq);
+        assert!(treq.max_tokens.is_none(), "gpt-5 tool path must drop max_tokens");
+
+        // gpt-4o: max_tokens is preserved.
+        let g4 = client.completion_model("gpt-4o");
+        let adapter4 = RigAdapter::new(g4, "gpt-4o");
+        let mut req4 = CompletionRequest::new(vec![ChatMessage::user("hi")]);
+        req4.max_tokens = Some(100);
+        adapter4.strip_unsupported_completion_params(&mut req4);
+        assert_eq!(req4.max_tokens, Some(100), "gpt-4o keeps max_tokens");
+    }
