+/// OpenAI models that REJECT the legacy `max_tokens` parameter and require
+/// `max_completion_tokens` instead — the gpt-5 family and the o-series reasoning
+/// models. Sending `max_tokens` to these returns HTTP 400 "Unsupported
+/// parameter: 'max_tokens' is not supported with this model."
+///
+/// `gpt-4o` / `gpt-4.1` still accept `max_tokens`, so they are deliberately NOT
+/// listed.
+const REQUIRES_MAX_COMPLETION_TOKENS_PATTERNS: &[&str] = &["gpt-5", "o1", "o3", "o4"];
+
+/// Returns `true` when *model* rejects `max_tokens` and needs
+/// `max_completion_tokens` (OpenAI gpt-5 family / o-series).
+pub fn requires_max_completion_tokens(model: &str) -> bool {
+    let lower = model.to_ascii_lowercase();
+    REQUIRES_MAX_COMPLETION_TOKENS_PATTERNS
+        .iter()
+        .any(|p| lower.contains(p))
+}
+
