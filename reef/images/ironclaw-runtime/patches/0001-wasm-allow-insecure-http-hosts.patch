+/// Hosts for which plaintext HTTP and the private-IP SSRF guard are relaxed,
+/// from `IRONCLAW_ALLOW_INSECURE_HTTP_HOSTS` (comma-separated, case-insensitive).
+/// Default empty.
+///
+/// For local/dev topologies where an agent must reach a nearby service over
+/// http — e.g. a local Clawbits at `http://host.microsandbox.internal:8000` or
+/// `http://localhost:8000`. Scope is EXACTLY the named hostnames (matched on the
+/// URL host, before DNS resolution); every other host still requires https and
+/// is still subject to the private-IP guard. Operator-controlled, so it's a
+/// trusted allowlist — not a DNS-rebinding vector.
+pub(crate) fn insecure_http_hosts() -> Vec<String> {
+    parse_insecure_http_hosts(std::env::var("IRONCLAW_ALLOW_INSECURE_HTTP_HOSTS").ok().as_deref())
+}
+
+/// Pure parser for [`insecure_http_hosts`] so the splitting/normalization is
+/// unit-testable without touching the process-global environment.
+fn parse_insecure_http_hosts(value: Option<&str>) -> Vec<String> {
+    value
+        .map(|v| {
+            v.split(',')
+                .map(|h| h.trim().to_ascii_lowercase())
+                .filter(|h| !h.is_empty())
+                .collect()
+        })
+        .unwrap_or_default()
+}
