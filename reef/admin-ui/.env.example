# Where the Vite dev server proxies /api -> the Reef admin/fleet API.
# Defaults to http://127.0.0.1:8787 (matches `uv run python -m reef.api`).
VITE_REEF_API_TARGET=http://127.0.0.1:8787

# Optional: if the Reef API has REEF_ADMIN_TOKEN set, put the same token here
# so the UI sends `Authorization: Bearer <token>`. Leave unset for local dev.
# VITE_REEF_ADMIN_TOKEN=
