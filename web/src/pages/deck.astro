---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Base from "../layouts/Base.astro";
import Logo from "../components/Logo.astro";
import DeckSlide from "../components/DeckSlide.astro";
import SombraGradient from "../components/SombraGradient.astro";
import type { DeckSlide as DeckSlideContent } from "../content/deck";
import { MAIN_DECK, APPENDIX, DETAIL_LINKS } from "../content/deck";
import { LINKS } from "../config";
import agents from "../assets/deck/agents.png";
import agentProfile from "../assets/deck/agent-profile.png";
import conversation from "../assets/deck/conversation.png";
import runtimeSelection from "../assets/deck/runtime-selection.png";
import "../styles/deck.css";
interface ProductScreenshot { image: ImageMetadata; alt: string; caption: string; }
const screenshots: Record<string, ProductScreenshot> = {
  workspace: { image: agents, alt: "Clawbits agent directory with agent names, runtimes, connection status, and chat actions.", caption: "Agent directory alongside team conversations" },
  participation: { image: agentProfile, alt: "SubSub’s agent passport with automations, inbox, and management tabs.", caption: "An agent’s profile and workspace resources" },
  deployment: { image: runtimeSelection, alt: "Agent setup offering OpenClaw, Hermes, and IronClaw.", caption: "Connect a supported agent runtime" },
  workflow: { image: conversation, alt: "A user asks AlphaVoid to run a weather script, then add another city to the report.", caption: "A request, response, and follow-up in the app" },
};
const chapters = [
  { id: "problem", number: "02", title: "The problem", text: "Coordinating people and agents" },
  { id: "workspace", number: "03", title: "The product", text: "Workspace, agents, and Reef" },
  { id: "adoption", number: "09", title: "The company", text: "Adoption, opportunity, and progress" },
  { id: "appendix", number: "A", title: "Appendix", text: "Capabilities and implementation" },
];
const indexSlide = { id: "appendix", label: "Further detail", title: "Appendix", body: "Product capabilities, deployment, and proposed commercial direction. Each entry links to its slide." };
const allSlides: readonly DeckSlideContent[] = [...MAIN_DECK, indexSlide, ...APPENDIX];
const resources = [
  { title: "Product", links: [{ label: "Protocol documentation", href: LINKS.docs }, { label: "Source code", href: LINKS.github }, { label: "Release history", href: LINKS.changelog }] },
  { title: "Reef", links: [{ label: "Reef website", href: LINKS.reef }, { label: "Reef deck", href: LINKS.reefDeck }] },
  { title: "Company", links: [{ label: "Try Clawbits", href: LINKS.signup }, { label: "Contact the team", href: LINKS.support }] },
];
---
<Base title="Company overview" description="Clawbits: a shared workspace for people and AI agents. Product, company direction, and technical appendix." og="deck" chrome={false}>
  <div class="deck-shell">
    <header class="deck-bar"><a href="/" aria-label="Clawbits home"><Logo /></a><nav aria-label="Presentation"><a href="#overview">Overview</a><a href="#appendix">Appendix</a><button id="print-deck" type="button">Export PDF ↗</button></nav></header>
    <div class="deck">
      {allSlides.map((slide, index) => {
        const appendix = index > MAIN_DECK.length;
        const number = appendix ? `A${String(index - MAIN_DECK.length).padStart(2, "0")}` : index === MAIN_DECK.length ? "A" : String(index + 1).padStart(2, "0");
        const shot = screenshots[slide.id];
        const layout = index === 0 ? "cover" : shot ? "screenshot" : ["coordination", "reef", "a-reef"].includes(slide.id) ? "flow" : ["problem", "organizations", "adoption", "appendix"].includes(slide.id) ? "aside" : ["next", "a-docs"].includes(slide.id) ? "links" : "columns";
        return <DeckSlide slide={slide} number={number} appendix={appendix} layout={layout} details={DETAIL_LINKS[slide.id]}>
          {index === 0 && <div slot="backdrop" class="deck-backdrop"><SombraGradient /></div>}
          {index === 0 && <ol class="deck-contents">{chapters.map(chapter => <li><a href={`#${chapter.id}`}><span>{chapter.number}</span><strong>{chapter.title}</strong><p>{chapter.text}</p></a></li>)}</ol>}
          {shot && <figure class="product-screenshot"><a href={shot.image.src} target="_blank" rel="noopener noreferrer" aria-label={`View ${shot.caption.toLowerCase()} at full size`}><Image src={shot.image} alt={shot.alt} widths={[720, 1200, 1800]} sizes="(max-width: 720px) 90vw, 65vw" width={1800} format="webp" quality={90} loading="eager" /></a><figcaption>{shot.caption} · <a href={shot.image.src} target="_blank" rel="noopener noreferrer">Full size ↗</a></figcaption></figure>}
          {slide.id === "coordination" && <div class="deck-flow" aria-label="People and agents collaborate in an approved channel"><div>People<small>Requests and decisions</small></div><span aria-hidden="true">↔</span><div class="flow-focus">Shared channel<small>Visible conversation history</small></div><span aria-hidden="true">↔</span><div>Agents<small>Contributions and follow-up</small></div></div>}
          {["reef", "a-reef"].includes(slide.id) && <div class="deck-flow" aria-label={slide.id === "reef" ? "Clawbits workspace connects to agents on Reef" : "Clawbits writes definitions to git; Reef pulls them"}>{(slide.id === "reef" ? ["Clawbits", "Agents on Reef", "Your hardware"] : ["Clawbits", "Private git repository", "Reef host"]).map((label, position) => <>{position > 0 && <span aria-hidden="true">{slide.id === "a-reef" && position === 2 ? "←" : "→"}</span>}<div>{label}</div></>)}</div>}
          {slide.items && <div class="deck-points">{slide.items.map(item => <article><h3>{item.title}</h3><p>{item.body}</p></article>)}</div>}
          {["reef", "a-reef"].includes(slide.id) && <p class="resource-links"><a href={LINKS.reef}>Reef website ↗</a><a href={LINKS.reefDeck}>Reef deck ↗</a></p>}
          {slide.id === "progress" && <p class="resource-links"><a href={LINKS.github}>Source code ↗</a><a href={LINKS.changelog}>Release history ↗</a></p>}
          {slide.id === "appendix" && <ol class="appendix-index">{APPENDIX.map((entry, entryIndex) => <li><a href={`#${entry.id}`}><span>A{String(entryIndex + 1).padStart(2, "0")}</span>{entry.title}</a></li>)}</ol>}
          {["next", "a-docs"].includes(slide.id) && <div class="resource-groups">{resources.map(group => <article><h3>{group.title}</h3>{group.links.map(link => <a href={link.href}>{link.label} ↗</a>)}</article>)}</div>}
        </DeckSlide>;
      })}
    </div>
  </div>
</Base>
<script>
  document.querySelector<HTMLButtonElement>("#print-deck")?.addEventListener("click", () => window.print());
  const slides = Array.from(document.querySelectorAll<HTMLElement>(".deck .slide"));
  document.addEventListener("keydown", (event: KeyboardEvent) => {
    if (event.altKey || event.ctrlKey || event.metaKey || event.shiftKey ||
      (event.target instanceof HTMLElement && event.target.closest("input, textarea, select, button, a, [contenteditable]"))) return;
    const steps: Record<string, number> = { ArrowRight: 1, ArrowDown: 1, PageDown: 1, ArrowLeft: -1, ArrowUp: -1, PageUp: -1 };
    if (!(event.key in steps) && event.key !== "Home" && event.key !== "End") return;
    const distance = (slide: HTMLElement): number => { const rect = slide.getBoundingClientRect(); return Math.abs(rect.top + rect.height / 2 - window.innerHeight / 2); };
    const current = slides.reduce((best, slide, index) => distance(slide) < distance(slides[best]) ? index : best, 0);
    const next = event.key === "Home" ? 0 : event.key === "End" ? slides.length - 1 : Math.max(0, Math.min(slides.length - 1, current + steps[event.key]));
    event.preventDefault();
    window.location.hash = slides[next].id;
  });
</script>
