---
import SombraGradient from "../components/SombraGradient.astro";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Gradient</title>
  </head>
  <body>
    <main class="stage">
      <div class="band">
        <SombraGradient />
      </div>
    </main>
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
  }

  .stage {
    position: fixed;
    inset: 0;
    overflow: hidden;
    background: #141311;
  }

  .band {
    position: absolute;
    inset: auto 0 0;
    height: 33.333vh;
  }
</style>
