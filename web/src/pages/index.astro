---
import Base from "../layouts/Base.astro";
import Button from "../components/Button.astro";
import Eyebrow from "../components/Eyebrow.astro";
import ShaderBackdrop from "../components/ShaderBackdrop.tsx";
import AppDemo from "../components/AppDemo.astro";
import PhoneDemo from "../components/PhoneDemo.astro";
import ReefVisual from "../components/ReefVisual.astro";
import IntroChat from "../components/IntroChat.astro";
import AgencyVisual from "../components/AgencyVisual.astro";
import AutomationVisual from "../components/AutomationVisual.astro";
import GitVisual from "../components/GitVisual.astro";
import InterAgentVisual from "../components/InterAgentVisual.astro";
import LobstertalkVisual from "../components/LobstertalkVisual.astro";
import MailboxVisual from "../components/MailboxVisual.astro";
import PlayOnView from "../components/PlayOnView.astro";
import { appLink, LINKS } from "../config";
import { PLATFORM_ICONS } from "../lib/platform-icons";
import {
  CLIENTS,
  COMPAT,
  ENDOWMENTS,
  FINAL_CTA,
  HERO,
  INTER_AGENT,
  INTRO,
  LOBSTERTALK,
  REEF,
  THESIS,
} from "../content/home";

/**
 * Homepage structure (owner direction 2026-08-04): a rounded shader canvas
 * with the nav, hero and cropped app window; then one railed column of
 * hairline-divided blocks; then a second, calmer canvas as the final CTA.
 * The layout metrics are measured values, not round numbers - check the plan
 * in the session notes before "rounding them off".
 *
 * All copy comes from src/content/home.ts so that llms.txt and llms-full.txt
 * render the same words. Do not inline new prose here.
 */

// The lede's lead/rest split for the intro's bold-lead typography. Derived,
// not re-typed, so the string cannot drift from home.ts.
const [ledeLead, ledeRest] = HERO.lede.split(" - ");

// Presentation-only lookups for the copy blocks (assets, links, glyphs stay
// out of home.ts - machines don't need them).
const AGENT_MARKS: Record<string, string> = {
  OpenClaw: "openclaw.png",
  Hermes: "hermes.svg",
  IronClaw: "ironclaw.webp",
};

/** Each runtime's own home. */
const AGENT_LINKS: Record<string, string> = {
  OpenClaw: "https://openclaw.ai/",
  Hermes: "https://hermes-agent.nousresearch.com/",
  IronClaw: "https://www.ironclaw.com/",
};

const PLATFORM_LINKS: Record<string, string> = {
  Web: appLink("/"),
  macOS: LINKS.download,
  Linux: LINKS.download,
};

/** Which inlined brand mark a platform card shows; Web draws its own globe. */
const PLATFORM_GLYPHS: Record<string, keyof typeof PLATFORM_ICONS | undefined> = {
  macOS: "apple",
  iOS: "apple",
  Linux: "linux",
  Android: "android",
};

/**
 * The real visual for each endowment, positionally matched to
 * ENDOWMENTS.items. A null keeps the honest wireframe card until that one is
 * built - do not reorder the copy without reordering this.
 */
const ENDOWMENT_VISUALS = [MailboxVisual, GitVisual, AutomationVisual, AgencyVisual];
---

<Base nav="overlay">
  {/* ── 1 · Hero canvas ──────────────────────────────────────────────── */}
  <div class="frame">
    <section class="canvas" data-theme-anchor>
      <div class="shader" aria-hidden="true">
        <ShaderBackdrop client:only="react" />
      </div>

      <div class="hero-head">
        <a class="badge" href={LINKS.lobstertalk}>
          {HERO.badge}<span class="chev" aria-hidden="true">›</span>
        </a>

        <h1 class="display display-hero">
          {HERO.lines.map((line) => <span class="line">{line}</span>)}
        </h1>

        <div class="hero-cta">
          {/* The event name is the PLACEMENT, not the destination - every CTA
              on the site points at the same /login, so "which button did the
              work" is the only question the report can answer. */}
          <Button href={LINKS.signup} variant="inverse" data-umami-event="signup-hero">Get Started</Button>
        </div>
      </div>

      <div class="stage">
        {/* Agent icon stack: peeks from behind the window's top-right
            corner (painted before AppDemo, so the window overlaps it).
            One link - hover lifts the icons and shows the tooltip, click
            goes to the app: "connect in 2 minutes" is a thing you do there,
            not a section to read. */}
        <a
          class="agent-stack"
          href={LINKS.signup}
          data-umami-event="signup-demo"
          aria-label="Connect OpenClaw, IronClaw or Hermes in 2 minutes"
        >
          {/* The name segment morphs per hovered icon: each name sits in a
              0fr grid track that opens to 1fr, so the pill's width animates
              smoothly between agents. */}
          <span class="stack-tip" aria-hidden="true">
            <span>Connect&nbsp;</span>
            <span class="tt-name tt-iron"><i>IronClaw</i></span>
            <span class="tt-name tt-open"><i>OpenClaw</i></span>
            <span class="tt-name tt-herm"><i>Hermes</i></span>
            <span>&nbsp;in 2 minutes</span>
          </span>
          <img class="sicon s-iron" src="/brand/ironclaw-ios.png" alt="" width="256" height="256" loading="lazy" />
          <img class="sicon s-open" src="/brand/openclaw-ios.png" alt="" width="256" height="256" loading="lazy" />
          <img class="sicon s-herm" src="/brand/hermes-ios.png" alt="" width="256" height="256" loading="lazy" />
        </a>
        <AppDemo />

        {/* The phone takes the stage on ≤40rem, where the desktop window
            stands down (AppDemo's own mobile block). Both ship in the HTML -
            Astro is static - but only the matching one paints, and the frame
            artwork is a media-gated background so this costs desktop nothing
            but markup. */}
        <div class="phone-slot"><PhoneDemo /></div>
      </div>
    </section>
  </div>

  <div class="rails">
    {/* ── 2 · Intro ──────────────────────────────────────────────────── */}
    <section class="block">
      <div class="intro-grid">
        <IntroChat class="intro-visual" />
        <div class="intro-copy">
          <div class="eyerow"><Eyebrow>{INTRO.eyebrow}</Eyebrow></div>
          <p><b>{THESIS.lead}</b> {THESIS.turn}</p>
          <p><b>{ledeLead}</b> - {ledeRest}</p>
        </div>
      </div>
    </section>

    {/* ── 3 · What each agent gets ───────────────────────────────────── */}
    <section class="block center">
      <div class="eyerow"><Eyebrow>{ENDOWMENTS.label}</Eyebrow></div>
      <h2 class="display display-xl">{ENDOWMENTS.heading}</h2>
      <ul class="cards">
        {
          ENDOWMENTS.items.map((item, i) => {
            const Visual = ENDOWMENT_VISUALS[i];
            return (
              <li>
                {Visual ? (
                  <Visual />
                ) : (
                  <div class:list={["pastel", `p${i}`]} aria-hidden="true">
                    <div class="mini">
                      <span class="mini-bar" />
                      <span class="mini-bar" />
                      <span class="mini-bar" />
                    </div>
                  </div>
                )}
                <p class="cap"><b>{item.title}</b> {item.body}</p>
              </li>
            );
          })
        }
      </ul>
    </section>

    {/* ── 4 · Compatibility: supported agent runtimes ────────────────── */}
    <section class="block center" id="compatibility">
      <div class="eyerow"><Eyebrow>{COMPAT.label}</Eyebrow></div>
      <h2 class="display display-xl">{COMPAT.heading}</h2>
      <p class="sub-lg centered">{COMPAT.body}</p>
      <ul class="agents">
        {
          COMPAT.agents.map((a) => (
            <li>
              <a
                class="agent-link"
                href={AGENT_LINKS[a.name]}
                target="_blank"
                rel="noopener noreferrer"
              >
                <div class:list={["agent-tile", `ag-${a.name.toLowerCase()}`]} aria-hidden="true">
                  <img
                    src={`/brand/agents/${AGENT_MARKS[a.name]}`}
                    alt=""
                    width="160"
                    height="160"
                    class="agent-mark"
                  />
                </div>
                <h3 class="agent-name">{a.name}</h3>
                <p class="agent-desc">{a.body}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    {/* ── 5 · Lobstertalk ────────────────────────────────────────────── */}
    <section class="block" id="lobstertalk">
      <div class="split">
        <div>
          <div class="eyerow"><Eyebrow>{LOBSTERTALK.label}</Eyebrow></div>
          <h3 class="display display-md">{LOBSTERTALK.heading}</h3>
          <p class="sub">{LOBSTERTALK.body}</p>
          <p class="sub sub-note">{LOBSTERTALK.note}</p>
        </div>
        {/* A channel where agents visibly decide to answer (or stay quiet):
            two escalations, the same three agents asked each time, a different
            one standing up. See the component for what the code actually
            does - the gate is agent-agnostic, so the fan-out is the point. */}
        <LobstertalkVisual class="lt-visual" />
      </div>
    </section>

    {/* ── 6 · Inter-agent mode ────────────────────────────────────────
        Full block width, not a split: the visual is a horizontal rally and
        needs the whole column. It also breaks a run of three splits. Placed
        directly after Lobstertalk because it only makes sense once the reader
        knows what the attention gate is - this is that gate pointed at
        agent-authored posts. */}
    <section class="block" id="inter-agent">
      <div class="eyerow"><Eyebrow>{INTER_AGENT.label}</Eyebrow></div>
      <h2 class="display display-xl">{INTER_AGENT.heading}</h2>
      <p class="sub-lg">{INTER_AGENT.body}</p>
      <p class="sub-lg sub-note">{INTER_AGENT.note}</p>
      <InterAgentVisual class="ia-visual" />
    </section>

    {/* ── 8 · Reef ───────────────────────────────────────────────────── */}
    <section class="block">
      <div class="reef-grid">
        <div>
          <div class="eyerow"><Eyebrow>{REEF.label}</Eyebrow></div>
          <h3 class="display display-md">{REEF.heading}</h3>
          <p class="sub">{REEF.body}</p>
          <p class="sub sub-note">{REEF.note}</p>
          <p class="more-row">
            <a class="more" href={LINKS.reef} target="_blank" rel="noopener noreferrer">
              Learn more
            </a>
          </p>
        </div>
        <ReefVisual />
      </div>
    </section>

    {/* ── 9 · Clients ────────────────────────────────────────────────── */}
    <section class="block center">
      <div class="eyerow"><Eyebrow>{CLIENTS.label}</Eyebrow></div>
      <h2 class="display display-xl">{CLIENTS.heading}</h2>
      <p class="sub-lg centered">{CLIENTS.body}</p>
      <ul class="pcards">
        {
          CLIENTS.platforms.map((p) => {
            const soon = "soon" in p && p.soon;
            const glyph = PLATFORM_GLYPHS[p.name];
            const icon = glyph ? PLATFORM_ICONS[glyph] : undefined;
            const cls = ["pcard", `pf-${p.name.toLowerCase()}`, { soon }];
            const inner = (
              <>
                {icon ? (
                  <svg class="pf-icon" viewBox={icon.viewBox} fill="currentColor" aria-hidden="true">
                    <path d={icon.d} />
                  </svg>
                ) : (
                  <svg
                    class="pf-icon"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                    aria-hidden="true"
                  >
                    <circle cx="12" cy="12" r="9" />
                    <ellipse cx="12" cy="12" rx="4" ry="9" />
                    <path d="M4 8h16M4 16h16" />
                  </svg>
                )}
                <span class="pf-name">{p.name}</span>
                {soon && <span class="pf-soon">Soon</span>}
              </>
            );
            return (
              <li>
                {soon ? (
                  <div class:list={cls}>{inner}</div>
                ) : (
                  <a
                    class:list={cls}
                    href={PLATFORM_LINKS[p.name]}
                    target={PLATFORM_LINKS[p.name].startsWith("http") ? "_blank" : undefined}
                    rel={PLATFORM_LINKS[p.name].startsWith("http") ? "noopener noreferrer" : undefined}
                  >
                    {inner}
                  </a>
                )}
              </li>
            );
          })
        }
      </ul>
    </section>

  </div>

  {/* ── 10 · Final CTA canvas ────────────────────────────────────────
      Outside the rails: the side hairlines end at the Clients block, and
      the .outro's full-width top border is the line that closes them. */}
  <div class="outro">
    <section class="block cta-block">
      <div class="cta-canvas">
        <div class="shader" aria-hidden="true">
          <ShaderBackdrop client:only="react" softness={0.7} intensity={0.32} noise={0.12} speed={0.55} />
        </div>
        <div class="cta-inner">
          <h2 class="display display-xl">{FINAL_CTA.heading}</h2>
          <p class="cta-note">{FINAL_CTA.note}</p>
          <div class="cta-btn">
            <Button href={LINKS.signup} variant="inverse" data-umami-event="signup-cta">Get Started</Button>
          </div>
        </div>
      </div>
    </section>
  </div>

  {/* Starts every looping card visual (IntroChat, the endowment cards) when
      it scrolls into view. Mounted once for the whole page. */}
  <PlayOnView />
</Base>

<style>
  /* ── Hero canvas ──────────────────────────────────────────────────────
   * Inset 16px from every page edge, radius up to ~34px, shadow-xl, overflow
   * hidden; the window's bottom ~130px are cropped by the edge. */
  /* THE OVERHANG. The window no longer stops at the shader - it carries on
   * past the canvas's lower edge and finishes on the cream, so the product
   * frame bridges the two halves of the page instead of being severed by the
   * seam. Its max width is 70.5rem, exactly the rails column, so the part that
   * hangs below lands precisely between the two hairlines.
   *
   * --hero-overhang (global.css) is read in both directions: .stage pulls the
   * canvas up by it, and the first railed block reserves it below. Which means
   * the clearance lives INSIDE the rails, so their vertical hairlines still
   * begin exactly at the canvas's lower edge and run up behind the part of the
   * window that hangs past it. No bottom padding here - that would push the
   * hairlines down and away from the canvas, which is the detail this whole
   * arrangement exists to keep. */
  .frame {
    padding: 1rem 1rem 0;
  }

  .canvas {
    position: relative;
    isolation: isolate;
    /* Visible, so the window can leave. The clip that used to live here has
     * moved to .shader, which is the only child that actually needed it - the
     * gradients and the WebGL canvas would otherwise spill past the rounded
     * corners. (The phone still wants a crop; see the narrow block below.) */
    overflow: visible;
    /* Visually identical to the rails hairlines. Those are 7%-alpha black
     * OVER CREAM; painted over this dark canvas the same alpha vanishes, so
     * the border uses the composited (opaque) result of line-over-ground. */
    border: 1px solid color-mix(in srgb, rgb(0 0 0) 7%, var(--color-ink));
    border-radius: clamp(0.75rem, 2.5vw, 2.125rem);
    background: var(--color-canvas);
    box-shadow:
      0 20px 25px -5px rgb(0 0 0 / 0.1),
      0 8px 10px -6px rgb(0 0 0 / 0.1);
    /* Consumed by the fixed nav (via timeline-scope on body): it slides in
     * exactly as this canvas finishes leaving the viewport. */
    view-timeline-name: --hero-view;
  }

  /* Static candy-on-ink gradient: what you see before the island hydrates,
   * without JS, or without WebGL. The shader canvas layers over it. */
  .shader {
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: inherit;
    overflow: hidden;
    background:
      radial-gradient(52% 68% at 18% 92%, rgb(232 66 92 / 0.5), transparent 64%),
      radial-gradient(44% 60% at 50% 104%, rgb(143 91 214 / 0.48), transparent 66%),
      radial-gradient(46% 62% at 82% 94%, rgb(74 143 224 / 0.42), transparent 64%),
      radial-gradient(30% 40% at 68% 78%, rgb(240 154 63 / 0.25), transparent 70%),
      var(--color-canvas);
  }

  /* Legibility scrim over the shader, under the text. A headline wants a calm
   * sky behind it and the truchet worms are not calm, so the text zone gets a
   * soft ink pool. Painted as ::after so it also covers the WebGL canvas. */
  .shader::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(
      75% 60% at 50% 38%,
      rgb(20 19 17 / 0.5),
      transparent 72%
    );
  }

  .hero-head {
    position: relative;
    z-index: 1;
    text-align: center;
    color: var(--color-canvas-text);
    /* Clears the 4rem fixed nav, then the 64px header padding. */
    padding: clamp(7rem, 5vw + 5rem, 8.5rem) clamp(1.5rem, 5vw, 3rem) 0;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    height: 1.625rem;
    padding-inline: 0.75rem;
    border-radius: 999px;
    margin-bottom: 1rem;
    font-size: 0.75rem;
    font-weight: 550;
    letter-spacing: 0.01em;
    text-decoration: none;
    color: rgb(255 255 255 / 0.92);
    /* Borderless (owner call) - the fill alone carries the pill. */
    background: rgb(255 255 255 / 0.16);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }

  .badge:hover {
    background: rgb(255 255 255 / 0.24);
  }

  .badge .chev {
    line-height: 1;
    translate: 0 -0.05em;
  }

  .hero-head h1 {
    margin: 0 0 2rem;
    color: #fff;
  }

  .hero-head .line {
    display: block;
  }

  .hero-cta {
    display: flex;
    justify-content: center;
  }

  /* The "Download app" secondary link under both Get Started buttons was
   * removed 2026-08-06 once Download joined the nav - along with the
   * data-platform script that existed solely to pick its icon. /download now
   * owns platform detection. */

  /* Window sits 64px under the CTA; the negative bottom margin is what pushes
   * its lower edge past the canvas boundary so overflow:hidden crops it
   * (130 of 720px hidden at the reference width). */
  .stage {
    position: relative;
    z-index: 1;
    margin-top: clamp(2.75rem, 4.9vw, 4.0625rem);
    /* Pulls the canvas's lower edge up across the window by exactly the
     * overhang the frame reserved below it. */
    margin-bottom: calc(var(--hero-overhang) * -1);
  }

  /* ── Agent icon stack, tucked behind the window's top-right corner.
   * The window's right edge sits at calc(50% - min(45.3%, 35.25rem))
   * from the stage edge (half of AppDemo's min(90.6%, 70.5rem) width),
   * so the stack anchors relative to that corner. Icons carry their own
   * squircle alpha - drop-shadow traces it. ── */
  .agent-stack {
    position: absolute;
    top: -2.75rem;
    right: calc(50% - min(45.3%, 35.25rem) + 3.5rem);
    display: flex;
    align-items: flex-start;
  }

  .sicon {
    width: 3.4rem;
    height: 3.4rem;
    translate: 0 var(--dy);
    rotate: var(--rot);
    filter: drop-shadow(0 12px 26px rgb(0 0 0 / 0.45));
    transition: translate 380ms var(--ease-out-expo);
  }

  /* Slightly different rotation + resting height per icon; DOM order
   * stacks them left-to-back → right-to-front. */
  .s-iron { --dy: 12px; --rot: -9deg; margin-right: -0.8rem; }
  .s-open { --dy: 2px; --rot: 4deg; margin-right: -0.8rem; }
  .s-herm { --dy: 8px; --rot: 10deg; }

  /* Load-in: each icon rises from fully behind the window frame, one by
   * one (no fade needed - the frame itself is the mask). `backwards`
   * holds them hidden through their stagger delay. */
  @media (prefers-reduced-motion: no-preference) {
    .sicon {
      animation: stack-rise 650ms var(--ease-out-expo) backwards;
    }

    .s-iron { animation-delay: 400ms; }
    .s-open { animation-delay: 560ms; }
    .s-herm { animation-delay: 720ms; }
  }

  @keyframes stack-rise {
    from {
      translate: 0 calc(var(--dy) + 52px);
    }
  }

  /* Only the hovered icon rises. */
  .sicon:hover {
    translate: 0 calc(var(--dy) - 12px);
  }

  .agent-stack:focus-visible .sicon {
    translate: 0 calc(var(--dy) - 12px);
  }

  .agent-stack:focus-visible {
    outline: 2px solid var(--color-signal);
    outline-offset: 4px;
    border-radius: 1rem;
  }

  /* Cream pill above the stack; rises in with the icons. */
  .stack-tip {
    position: absolute;
    bottom: calc(100% + 1.125rem);
    left: 50%;
    translate: -50% 4px;
    display: inline-flex;
    align-items: baseline;
    padding: 0.375rem 0.75rem;
    border-radius: 0.625rem;
    background: var(--color-ink);
    color: var(--color-paper);
    font-size: 0.75rem;
    font-weight: 500;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 200ms var(--ease-out-expo),
      translate 200ms var(--ease-out-expo);
  }

  .agent-stack:hover .stack-tip,
  .agent-stack:focus-visible .stack-tip {
    opacity: 1;
    translate: -50% 0;
  }

  /* Collapsible name segments: the hovered agent's name opens to its
   * measured width, the others close to 0 - the pill resizes smoothly
   * between labels. Widths are fixed per name (0fr→1fr grid tracks
   * contribute nothing to an inline-flex pill's intrinsic width, so fr
   * animation collapses here); Geist is self-hosted, so the metrics are
   * deterministic. */
  .tt-name {
    display: inline-block;
    width: 0;
    overflow: hidden;
    white-space: nowrap;
    transition: width 320ms var(--ease-out-expo);
  }

  .tt-name > i {
    font-style: normal;
  }

  .agent-stack:has(.s-iron:hover) .tt-iron { width: 50px; }
  .agent-stack:has(.s-open:hover) .tt-open { width: 59px; }

  .agent-stack:has(.s-herm:hover) .tt-herm,
  /* Nothing specific hovered (focus, or the sliver between icons):
     default to the front icon's name. */
  .agent-stack:not(:has(.sicon:hover)) .tt-herm {
    width: 44px;
  }

  /* Desktop shows the window; the phone waits for its media query. */
  .phone-slot {
    display: none;
  }

  /* No room for the stack once the window goes near-full-bleed. */
  @media (max-width: 40rem) {
    .agent-stack {
      display: none;
    }
  }

  /* The stack's anchor target: keep the heading clear of the fixed nav. */
  #compatibility {
    scroll-margin-top: 4.5rem;
  }

  @media (max-width: 40rem) {
    /* Full-bleed on phones. The 1rem inset that frames the canvas as a card on
     * desktop just wastes width here, and a floating rounded rectangle inside
     * a 375px viewport reads as a component rather than as the top of the page.
     * Corners stay rounded on the BOTTOM edge only - the top edge, the sides
     * and their borders now coincide with the screen, and a radius on an edge
     * that touches the viewport shows the page ground through the corner. */
    /* ONE vertical line down each side of the hero. The wordmark, the badge,
     * the headline, the button and the phone's BODY all start on it; the
     * hamburger and the phone's other edge end on its mirror. Nav.astro reads
     * the same variable (it is set on :root in global.css so both components
     * can), which is what stops the two drifting apart. */
    .frame {
      padding: 0;

      /* What shows THROUGH the canvas's rounded corners.
       *
       * <main> declares the page ground (global.css - body's own background is
       * the signal that colours Safari's chrome, so it cannot also be paint),
       * which left cream notches at the corners the moment the top pair stopped
       * being square. The two ends want different answers: the top corners
       * continue the dark strip above the page, the bottom corners meet the
       * cream rails below. A hard stop past the radius gives each its own. */
      background: linear-gradient(
        to bottom,
        var(--color-canvas) 2rem,
        var(--color-ink) 2rem
      );
    }

    .canvas {
      /* The phone IS cropped by the canvas edge - the whole composition
       * depends on it (see --ph-crop). So the clip comes back here, where the
       * desktop window is display:none anyway. */
      overflow: hidden;
      /* NO border at all here (owner, 2026-08-07). The top and sides went when
       * the canvas became full-bleed - a hairline on an edge that coincides
       * with the screen is just a line down the screen - and the bottom one
       * follows now that all four corners are rounded, because a single edge
       * of a rounded ring reads as an outline around the whole section. The
       * canvas is still separated from the page by the thing that actually
       * separates it: it is dark and the page is not. */
      border: 0;
      /* Rounded on all four corners now, not just the bottom. The top pair
       * used to be square because a radius on an edge that touches the
       * viewport shows the page ground through the corner - and the ground was
       * cream. It is the canvas colour while the hero holds the top (see the
       * [data-hero-top] note in global.css), so the corners now read as the
       * shader being cut rather than as a leak. */
      border-radius: clamp(1rem, 5vw, 1.75rem);
    }

    .hero-head {
      text-align: left;
      /* Tighter than the old 2rem: buys the width that keeps the long first
       * headline line unwrapped at the clamp floor. */
      padding-inline: var(--hero-gutter);
    }

    .hero-cta {
      justify-content: flex-start;
    }

    /* ── The phone takes the stage ──────────────────────────────────────
     *
     * Wide on purpose. A device sized to "sit in a scene" (~65% of the
     * viewport) puts the app's 13pt preview text at 7.5px, which is a blurry
     * stock mockup rather than a product shot - the desktop window is legible
     * only because it renders at ~1:1, and a 402pt screen cannot do that on a
     * 390px viewport. At 86% the screen scales to ~0.75 and the type holds.
     *
     * --phone-w is read twice, and both readings resolve their percentage
     * against the same box (this canvas), which is what keeps the crop
     * correct at every width. */
    .stage {
      /* THE ALIGNMENT. The artwork's flat body runs x 8..441 of 450, so 1.7778%
       * of the element is transparent padding on each side and the element has
       * to be WIDER than the gutter allows for its body to land on it:
       *
       *   bodyLeft = (W - E)/2 + 0.017778E = gutter   ->   E = (W - 2g)/0.964444
       *
       * Centred, so the right edge mirrors it for free. The side buttons still
       * poke ~2px past the line, which is what a real phone does. */
      --phone-w: calc((100% - 2 * var(--hero-gutter)) / 0.964444);

      /* How much SCREEN the canvas cuts off, in iOS points. PhoneDemo reads the
       * same variable to pad its message feed by the same amount, so the newest
       * messages stay above the fold instead of being cut away with the chin.
       *
       * At 240 the iOS tab bar goes with it - deliberate. The phone opens on a
       * conversation, which is a pushed route with no tab bar anyway, and a
       * hero that ran past 1.3 viewports was the thing being fixed.
       *
       * The margin is that number plus the 23px of bezel below the screen, over
       * the artwork's 450px width - a margin percentage has no other basis. */
      --ph-crop: 240;
      margin-bottom: calc(var(--phone-w) * (var(--ph-crop) + 23) / -450);
    }

    .phone-slot {
      display: block;
      width: var(--phone-w);
      margin-inline: auto;
    }

    /* Entrance. The desktop hero already opens with the agent icons rising out
     * from behind the window (stack-rise, above); this is the phone's version
     * of the same beat - it arrives from under the canvas edge, which is where
     * the crop already implies it continues to.
     *
     * On .phone-slot, not on the phone itself: the slot is a plain box, while
     * .phone carries `container-type: inline-size` and the message feed's
     * scroll-driven animation hangs off its descendants. Keeping the entrance
     * one level out means the two never share a property. */
    @media (prefers-reduced-motion: no-preference) {
