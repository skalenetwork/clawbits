---
import Base from "./Base.astro";
import { LINKS } from "../config";

/**
 * Frame for /privacy and /terms.
 *
 * Mirrors the structure of the SPA pages these were ported from
 * (frontend/src/pages/{Privacy,Terms}Page.tsx): eyebrow, title, date line,
 * intro, "On this page" index, the sections, then the operator's copyright
 * line. The legal TEXT itself must not drift from those pages - see
 * scripts/verify-legal-parity.mjs, which diffs the rendered words against the
 * TSX source and fails on any change.
 */

interface Props {
  title: string;
  /** Rendered verbatim into "Last updated: X · Effective: X". */
  effectiveDate: string;
  description: string;
  /** Drives the index. Must match the LegalSection blocks in the page 1:1 -
      the parity script enforces this. */
  sections: { id: string; title: string }[];
  /** Sibling legal page, linked from the footer. */
  sibling: { href: string; label: string };
  /** Social card for this document; privacy and terms have their own. */
  ogImage: string;
}

const { title, effectiveDate, description, sections, sibling, ogImage } = Astro.props;
const year = new Date().getFullYear();

// A plain WebPage node. Deliberately NOT a made-up "PrivacyPolicy" type -
// schema.org has no such WebPage subtype, and inventing one produces markup a
// validator rejects, which is worse than omitting it.
//
// `dateModified` is the document's own effective date, parsed from the same
// string the page displays, so the two can never disagree.
const modified = new Date(`${effectiveDate} UTC`);
const schema = [
  {
    "@type": "WebPage",
    "@id": new URL(Astro.url.pathname, Astro.site).href,
    name: title,
    description,
    isPartOf: { "@id": `${Astro.site}#website` },
    about: { "@id": `${Astro.site}#software` },
    publisher: { "@id": `${Astro.site}#organization` },
    ...(Number.isNaN(modified.valueOf())
      ? {}
      : { dateModified: modified.toISOString().slice(0, 10) }),
  },
];
---

<Base title={title} description={description} ogImage={ogImage} schema={schema}>
  <div class="legal">
    <header class="head">
      <p class="eyebrow">Legal</p>
      <h1 class="display display-lg">{title}</h1>
      <p class="dates">
        Last updated: {effectiveDate} &middot; Effective: {effectiveDate}
      </p>
    </header>

    <div class="intro">
      <slot name="intro" />
    </div>

    <nav class="toc" aria-label="On this page">
      <p class="toc-label">On this page</p>
      <ol>
        {sections.map((s) => <li><a href={`#${s.id}`}>{s.title}</a></li>)}
      </ol>
    </nav>

    <article class="prose">
      <slot />
    </article>

    <hr />

    <footer class="foot">
      <span>&copy; {year} SKALE Labs - Portugal</span>
      <div class="foot-links">
        <a href={sibling.href}>{sibling.label}</a>
        <a href={LINKS.changelog}>Changelog</a>
        <a href={LINKS.signin}>Back to sign in</a>
        <a href={LINKS.legal}>legal@clawbits.ai</a>
      </div>
    </footer>
  </div>
</Base>

<style>
  .legal {
    width: 100%;
    max-width: 48rem;
    margin-inline: auto;
    padding-inline: clamp(1.5rem, 6vw, 5rem);
    padding-block: clamp(3.5rem, 8vw, 6rem) clamp(4rem, 8vw, 6rem);
  }

  .head .eyebrow {
    margin-bottom: 1rem;
  }

  .dates {
    margin-top: 1.125rem;
    font-size: 0.875rem;
    color: var(--color-faint);
  }

  .intro {
    margin-top: 2.5rem;
    color: var(--color-muted);
  }

  /* Index. The one boxed element on the site - it is a utility, not a content
   * card, and it needs to read as separable from the policy text. */
  .toc {
    margin-top: 2.5rem;
    padding: 1.375rem 1.5rem;
    border: 1px solid var(--color-line);
    border-radius: 0.875rem;
    background: var(--color-ink-raised);
  }

  .toc-label {
    margin: 0 0 0.875rem;
    font-size: 0.8125rem;
    color: var(--color-faint);
  }

  .toc ol {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.875rem;
  }

  @media (max-width: 34rem) {
    .toc ol {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .toc a {
    color: var(--color-muted);
    text-decoration: none;
  }

  .toc a:hover {
    color: var(--color-paper);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  hr {
    margin-block: 4rem 2rem;
    border: 0;
    border-top: 1px solid var(--color-line);
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.75rem;
    color: var(--color-faint);
  }

  .foot-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .foot a {
    color: inherit;
    text-decoration: none;
  }

  .foot a:hover {
    color: var(--color-paper);
  }
</style>

<style is:global>
  /* Legal body copy. Global rather than scoped because the content arrives
   * through a <slot> from the page, so it carries the PAGE's scope id, not
   * this layout's - the same boundary that silently killed rules in Phase 1.
   * Confined to .prose so it cannot leak into the rest of the site. */
  .legal .prose {
    margin-top: 3rem;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .legal .prose h2 {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    /* Clears the sticky nav when an anchor is followed. */
    scroll-margin-top: 6rem;
  }

  .legal .prose h3 {
    margin-top: 1.75rem;
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-paper);
  }

  .legal .prose p,
  .legal .prose li {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-muted);
  }

  .legal .prose p {
    margin-top: 1rem;
  }

  .legal .prose h2 + p,
  .legal .prose h3 + p {
    margin-top: 0.75rem;
  }

  .legal .prose ul {
    margin-top: 1rem;
    padding-inline-start: 1.125rem;
    list-style: disc;
  }

  .legal .prose li {
    margin-top: 0.5rem;
  }

  .legal .prose li::marker {
    color: var(--color-faint);
  }

  .legal .prose strong {
    color: var(--color-paper);
    font-weight: 600;
  }

  .legal .prose code {
    font-family: var(--font-mono);
    font-size: 0.8125em;
    color: var(--color-paper);
  }

  .legal .prose a,
  .legal .intro a {
    color: var(--color-paper);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .legal .prose a:hover,
  .legal .intro a:hover {
    text-decoration: none;
  }

  .legal .intro p {
    font-size: 0.9375rem;
    line-height: 1.7;
  }
</style>
