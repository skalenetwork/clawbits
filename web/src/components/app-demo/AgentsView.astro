---
import { Bot } from "lucide";
import { authorName, CAST, type AgentFacts, type Chat, type Who } from "../../content/demo-chats";
import { ico } from "../../lib/appicon";

interface Props {
  chats: Chat[];
}

interface Agent {
  who: Who;
  agent: AgentFacts;
}

const { chats } = Astro.props;

const agents: Agent[] = (Object.keys(CAST) as Who[]).flatMap((who) => {
  const { agent } = CAST[who];
  return agent ? [{ who, agent }] : [];
});
const groups: [string, Agent[]][] = [
  ["Your agents", agents.filter((a) => a.agent.owner === "you")],
  ["Other agents", agents.filter((a) => a.agent.owner !== "you")],
];
---

<section class="view view-agents" aria-label="Agents">
  <div class="scroll">
    <div class="page">
      {
        groups.map(([label, list]) => (
          <section>
            <h2>{label}</h2>
            <div class="stack">
              {list.map(({ who, agent }) => {
                const p = CAST[who];
                const dm = agent.dm ? chats.find((c) => c.peer === who) : undefined;
                const Tag = dm ? "label" : "span";
                return (
                  <article class="card">
                    <div class="row">
                      <span class="face">
                        <img class="ava ava-agent s40" src={p.ava} alt="" width="40" height="40" />
                        <span class:list={["pd", `pd-${p.presence}`]} />
                      </span>
                      <span class="who">
                        <span class="name trunc">{p.name}</span>
                        <span class="desc trunc">{agent.blurb}</span>
                      </span>
                      <span class="slot">
                        <Tag class:list={["btn", "chat", { off: !agent.dm }]} for={dm && `v-${dm.id}`}>
                          Chat
                          {!!dm?.unread && <span class="badge">{dm.unread}</span>}
                        </Tag>
                      </span>
                    </div>
                    <div class="strip">
                      <span class="runtime">
                        <img src={`/brand/${agent.runtime}-ios.png`} alt="" width="16" height="16" loading="lazy" decoding="async" />
                        <span class="version trunc">
                          {agent.host === "self" && (
                            <>
                              <span class="place">Self-hosted</span>
                              {" · "}
                            </>
                          )}
                          {[agent.engine, `plugin ${agent.plugin}`].filter(Boolean).join(" · ")}
                        </span>
                        {p.presence === "setup" && <span class="phrase">· not connected yet</span>}
                      </span>
                      <span class="owner">
                        <img class="ava ava-human s16" src={CAST[agent.owner].ava} alt="" width="16" height="16" />
                        <span class="trunc">{authorName(agent.owner)}</span>
                      </span>
                    </div>
                  </article>
                );
              })}
            </div>
          </section>
        ))
      }
    </div>
  </div>

  <header class="bar">
    <div class="scrim"><i></i><i></i><i></i><i></i><i></i></div>
    <span class="crumb"><span class="ic s16" set:html={ico(Bot)} />Agents</span>
    <span class="btn primary">New agent</span>
  </header>
</section>

<style>
  .scroll {
    height: 100%;
    padding: 0 8px;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: color-mix(in oklch, var(--ink) 15%, transparent) transparent;
  }

  .page {
    display: flex;
    flex-direction: column;
    gap: 28px;
    max-width: 640px;
    margin: 0 auto;
    padding: 88px 0 64px;
  }

  h2 {
    padding: 0 12px 8px;
    font-size: 13px;
    font-weight: 500;
    color: var(--mut);
  }

  .stack {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .card {
    border-radius: 14px;
    background: var(--panel);
  }

  .card:hover:not(:has(.chat:hover)) {
    background: color-mix(in oklch, var(--panel), var(--ink) 4%);
  }

  .row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px;
  }

  .face {
    position: relative;
    display: flex;
    flex-shrink: 0;
  }

  .pd {
    right: -2px;
    bottom: -2px;
    width: 10px;
    height: 10px;
    box-shadow: 0 0 0 2px var(--panel);
  }

  .who {
    flex: 1;
    min-width: 0;
    line-height: 20px;
  }

  .name,
  .desc {
    display: block;
  }

  .name {
    font-size: 15px;
    font-weight: 500;
  }

  .desc {
    font-size: 13px;
    color: var(--mut);
  }

  .slot {
    display: flex;
    flex-shrink: 0;
    justify-content: flex-end;
    width: 80px;
  }

  .btn {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    gap: 4px;
    height: 32px;
    padding: 0 12px;
    border: 1px solid transparent;
    border-radius: 10px;
    background-clip: padding-box;
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
    white-space: nowrap;
    transition: all 150ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .btn:active {
    translate: 0 1px;
  }

  label.btn {
    cursor: pointer;
  }

  .primary {
    background-color: var(--primary);
    color: var(--primary-fg);
  }

  .primary:hover {
    background-color: color-mix(in oklab, var(--primary) 80%, transparent);
  }

  .chat {
    border-color: var(--line);
    background-color: var(--bg);
  }

  .chat:hover {
    background-color: var(--muted);
  }

  .off {
    opacity: 0.5;
    pointer-events: none;
  }

  .badge {
    display: grid;
    place-items: center;
    min-width: 16px;
    height: 16px;
    padding: 0 4px;
    border-radius: 9999px;
    background: var(--primary);
    font-size: 11px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--primary-fg);
  }

  .strip {
    position: relative;
    display: flex;
    align-items: center;
    gap: 16px;
    height: 40px;
    padding: 0 16px;
    font-size: 13px;
    font-variant-numeric: tabular-nums;
  }

  .strip::before {
    content: "";
    position: absolute;
    inset: 0 16px auto;
    height: 1px;
    background: color-mix(in oklab, var(--ink) 8%, transparent);
  }

  .runtime {
    display: flex;
    flex: 1;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }

  .runtime img {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  .version {
    color: var(--mut);
  }

  .place {
    color: var(--ink);
  }

  .phrase {
    flex-shrink: 0;
    color: var(--mut);
  }

  .owner {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 8px;
    max-width: 45%;
  }

  .bar {
    justify-content: space-between;
  }

  .crumb {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
    padding: 4px 6px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
    line-height: 20px;
  }
</style>
