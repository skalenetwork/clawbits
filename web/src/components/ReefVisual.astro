---
/**
 * The Reef section's visual: a reviewed file goes into Reef and a fleet of
 * sealed agents comes out.
 *
 * One 12s loop (1% = 120ms), paused on its 0% frame (Reef alone) until
 * PlayOnView adds `play`. Defaults are the settled frame (file, Reef, fleet
 * running), which prefers-reduced-motion keeps.
 *   2-13%   the reviewed file fades in above Reef and its check draws
 *   13-21%  the file glides down behind the Reef tile, which pulses
 *   21-42%  three agents slide out onto an even arc 0.48s apart, dots amber then green
 *   42-61%  the next approved file arrives the same way
 *   61-79%  an amber ripple runs out; agents re-pop one by one, amber then green
 *   86-98%  the fleet fades out one by one, leaving Reef for the wrap
 */

const AGENTS: string[] = ["agent-4", "agent-1", "agent-2"];
---

<div class="rv-box" data-play-on-view aria-hidden="true">
  <span class="rv-ripple rv-loop"></span>
  {
    AGENTS.map((name, i) => (
      <div class={`rv-agent rv-loop rv-a${i + 1}`}>
        <img src={`/avatars/${name}.svg`} alt="" width="120" height="120" loading="lazy" />
        <span class="rv-dot rv-loop" />
      </div>
    ))
  }
  <svg class="rv-file rv-loop" viewBox="0 0 30 36">
    <path class="rv-sheet" d="M5.5.5H21L29.5 9v21.5a5 5 0 0 1-5 5h-19a5 5 0 0 1-5-5v-25a5 5 0 0 1 5-5z" />
    <path class="rv-sheet rv-fold" d="M21 .5V6a3 3 0 0 0 3 3h5.5z" />
    <path class="rv-check rv-loop" d="M9.5 20.5l3.8 3.8 7.2-7.6" pathLength="1" />
  </svg>
  <img class="rv-reef rv-loop" src="/reef-light.webp" alt="" width="256" height="256" loading="lazy" />
</div>

<style>
  .rv-box {
    --rv-x: 0cqw;
    --rv-y: 0cqw;
    --rv-lift: drop-shadow(0 0.8cqw 1.4cqw rgb(30 30 30 / 0.14));

    display: grid;
    grid-template: 1fr / 1fr;
    place-items: center;
    width: 100%;
    aspect-ratio: 4 / 3;
    container-type: inline-size;
    border-radius: 1rem;
    background: linear-gradient(150deg, #fdeaec, #f8ccd4);
  }

  .rv-box > * {
    grid-area: 1 / 1;
    position: relative;
    left: var(--rv-x);
    top: calc(var(--rv-y) - 3.5cqw);
  }

  .rv-reef {
    width: 19cqw;
    height: 19cqw;
    filter: var(--rv-lift);
  }

  .rv-ripple {
    width: 18cqw;
    height: 18cqw;
    border-radius: 4.4cqw;
    outline: 1.5px solid rgb(245 158 11 / 0.6);
    opacity: 0;
  }

  .rv-agent {
    display: grid;
    place-items: center;
    width: 14cqw;
    height: 14cqw;
    border-radius: 4cqw;
    background: rgb(255 255 255 / 0.5);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.7),
      0 0.8cqw 1.8cqw rgb(30 30 30 / 0.08);
  }

  .rv-agent img {
    width: 9cqw;
    height: 9cqw;
    border-radius: 40% 40% 40% 15%;
    background: #dbd7cc;
  }

  .rv-a1 { --rv-x: -21.7cqw; --rv-y: 12.5cqw; }
  .rv-a2 { --rv-y: 25cqw; }
  .rv-a3 { --rv-x: 21.7cqw; --rv-y: 12.5cqw; }

  .rv-dot {
    position: absolute;
    right: 2.3cqw;
    bottom: 2.3cqw;
    width: 2.4cqw;
    height: 2.4cqw;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 0 0.4cqw #fff;
  }

  .rv-file {
    --rv-y: -20cqw;
    width: 8cqw;
    height: 9.6cqw;
    overflow: visible;
    filter: var(--rv-lift);
  }

  .rv-sheet {
    fill: #fff;
    stroke: rgb(30 30 30 / 0.14);
    vector-effect: non-scaling-stroke;
  }

  .rv-fold { fill: #f3f2ee; }

  .rv-check {
    fill: none;
    stroke: #1e1e1e;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1 2;
  }

  @media (prefers-reduced-motion: no-preference) {
    .rv-loop {
      animation-duration: 12s;
      animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
      animation-iteration-count: infinite;
      animation-fill-mode: backwards;
      animation-play-state: paused;
    }

    .play .rv-loop { animation-play-state: running; }

    .rv-file { animation-name: rv-file; animation-timing-function: cubic-bezier(0.65, 0, 0.35, 1); }
    .rv-check { animation-name: rv-check; }
    .rv-reef { animation-name: rv-reef; }
    .rv-ripple { animation-name: rv-ripple; animation-timing-function: cubic-bezier(0.33, 1, 0.68, 1); }
    .rv-agent { animation-name: rv-agent; }
    .rv-dot { animation-name: rv-dot; }

    .rv-a2, .rv-a2 .rv-dot { animation-delay: 0.48s; }
    .rv-a3, .rv-a3 .rv-dot { animation-delay: 0.96s; }
  }

  @keyframes rv-file {
    0%, 2%, 42% { opacity: 0; translate: 0 1.5cqw; scale: 1; }
    8%, 13%, 48%, 53% { opacity: 1; translate: 0 0; scale: 1; }
    17%, 57% { opacity: 1; }
    21%, 61%, 100% { opacity: 0; translate: 0 calc(var(--rv-y) * -1); scale: 0.5; }
  }

  @keyframes rv-check {
    0%, 6%, 42%, 46%, 100% { stroke-dashoffset: 1.1; }
    11%, 21%, 51%, 61% { stroke-dashoffset: 0; }
  }

  @keyframes rv-reef {
    0%, 20%, 30%, 60%, 70%, 100% { scale: 1; }
    23%, 63% { scale: 1.05; }
  }

  @keyframes rv-ripple {
    0%, 61% { opacity: 0; outline-offset: 0; }
    62% { opacity: 1; }
    78%, 100% { opacity: 0; outline-offset: 18cqw; }
  }

  @keyframes rv-agent {
    0%, 21%, 91%, 100% { opacity: 0; translate: calc(var(--rv-x) * -1) calc(var(--rv-y) * -1); scale: 0.4; }
    29%, 63%, 72%, 86% { opacity: 1; translate: 0 0; scale: 1; }
    65% { scale: 0.86; }
    90% { opacity: 0; translate: 0 0; scale: 0.92; }
  }

  @keyframes rv-dot {
    0%, 30%, 64%, 68% { background-color: #f59e0b; }
    34%, 63%, 71%, 100% { background-color: #10b981; }
  }
</style>
