  #ph-v-hermes:checked ~ .screen .cv-hermes,
  #ph-v-lena:checked ~ .screen .cv-lena,
  #ph-v-allhands:checked ~ .screen .cv-allhands,
  #ph-v-scout:checked ~ .screen .cv-scout,
  #ph-v-eng:checked ~ .screen .cv-eng,
  #ph-v-clawbits:checked ~ .screen .cv-clawbits,
  #ph-v-smartclaws:checked ~ .screen .cv-smartclaws,
  #ph-v-pit:checked ~ .screen .cv-pit,
  #ph-v-josh:checked ~ .screen .cv-josh,
  #ph-v-quill:checked ~ .screen .cv-quill,
  #ph-v-sasha:checked ~ .screen .cv-sasha {
    display: flex;
  }

  /* ── 1 · Chats list ── */

  .lhead {
    position: absolute;
    inset: calc(62 * var(--pu)) 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 calc(20 * var(--pu));
    height: calc(52 * var(--pu));
  }

  /* The native large title, left-aligned (headerTitleAlign: 'left'). */
  .ltitle {
    font-size: calc(34 * var(--pu));
    font-weight: 700;
    letter-spacing: calc(-0.8 * var(--pu));
  }

  .lpill {
    display: inline-flex;
    align-items: center;
    gap: calc(6 * var(--pu));
    padding: calc(7 * var(--pu)) calc(12 * var(--pu));
    border-radius: 999px;
  }

  .pico {
    display: block;
    width: calc(20 * var(--pu));
  }

  .pico :global(svg),
  .tbi :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Scope tabs. `top` is the app's own insets.top + 52. */
  .tabsbar {
    position: absolute;
    inset: calc(122 * var(--pu)) calc(16 * var(--pu)) auto;
    z-index: 3;
    display: flex;
