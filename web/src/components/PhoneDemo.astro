                  ))}
                </div>
              ) : (
                <div class="sempty">Nothing shared here yet</div>
              )}
            </div>
          </div>
        </section>
      );
    })}

    {/* ── 3 · iOS 26 tab bar. System chrome, hidden on pushed routes. ── */}
    <nav class="tabbar glass">
      <span class="tbtn"><i set:html={SF.homeGrid} /><b>Home</b></span>
      <span class="tbtn on"><i set:html={SF.message} /><b>Chats</b></span>
      <span class="tbtn"><i set:html={SF.search} /><b>Search</b></span>
      <span class="tbtn"><i set:html={SF.gears} /><b>Settings</b></span>
    </nav>
  </div>

  {/* The device artwork, painted OVER the screen. The PNG carries a
      transparent aperture, so the bezel, the corners and the Dynamic Island
      are the image's job, not CSS's. Until the asset lands this element draws
      a placeholder bezel from the same aperture variables - see --ap-*. */}
  <div class="frame"></div>
</div>

<script>
  /**
   * The status bar shows the READER'S clock.
   *
   * A device frame with 9:41 frozen on it is a stock mockup; the same frame
   * showing the time on the phone in your hand is a product shot. It is the
   * cheapest "this is running" signal on the page, and the only one here that
   * CSS genuinely cannot produce.
   *
   * Bundled, not inline: Astro emits this as a module under /_astro, which the
   * CSP already allows via script-src 'self'. An inline script would depend on
   * the build-computed hash surviving, for no gain.
   *
   * Server-rendered as 9:41, so a reader with JS off keeps Apple's marketing
   * time rather than an empty status bar.
   */
  const clocks = document.querySelectorAll("[data-phone-clock]");

  if (clocks.length > 0) {
    /* The reader's own locale and hour cycle - a 24-hour reader should not be
     * shown a 12-hour phone. `hour: "numeric"` is right for a 12-hour clock
     * (iOS shows "9:41", not "09:41") and wrong for a 24-hour one, where iOS
     * pads; ask the runtime which it resolved to rather than guessing from the
     * language tag. */
    const probe = new Intl.DateTimeFormat(undefined, { hour: "numeric", minute: "2-digit" });
    const cycle = probe.resolvedOptions().hourCycle;
    const wide = cycle === "h23" || cycle === "h24";
    const fmt = wide
      ? new Intl.DateTimeFormat(undefined, {
          hour: "2-digit",
          minute: "2-digit",
          hourCycle: cycle,
        })
      : probe;

    const paint = () => {
      /* iOS drops the AM/PM from the status bar, so the day period and the
       * space in front of it both go. Assembled from parts rather than by
       * regex: the hour-minute separator is not ":" in every locale. */
      const parts = fmt
        .formatToParts(new Date())
        .filter((p) => p.type === "hour" || p.type === "minute" || p.type === "literal");
      while (parts.length > 0 && parts[0].type === "literal") parts.shift();
      while (parts.length > 0 && parts[parts.length - 1].type === "literal") parts.pop();

      const text = parts.map((p) => p.value).join("");
      for (const node of clocks) node.textContent = text;
    };

    /* Repainted ON the minute, not every minute: a naive 60s interval drifts
     * and lands mid-minute, so the displayed time can be a full minute stale.
     * Every timezone offset is a whole number of minutes, so the epoch
     * remainder is the local one too. */
    let timer = 0;
    const tick = () => {
      paint();
      timer = window.setTimeout(tick, 60_000 - (Date.now() % 60_000) + 200);
    };
    tick();

    /* A backgrounded tab has its timers throttled, so the clock comes back
     * wrong; resync the moment it is looked at again. */
    document.addEventListener("visibilitychange", () => {
      if (!document.hidden) {
        clearTimeout(timer);
        tick();
      }
    });
  }
</script>

<style>
  /* ── The device ───────────────────────────────────────────────────────────
   * iPhone 17 Pro. The APERTURE numbers are not guesses - they are measured
   * out of /iphone.png's alpha channel, which is a true cut-out:
   *
   *   image        450 x 920
   *   body         x 8..441, y 7..912   (the side buttons reach x=5)
   *   aperture     x 24..425, y 23..896  ->  402 x 874
   *
   * 402x874pt is the 17 Pro's screen exactly (2622x1206 at 3x), so the asset
   * is a 1x render and every point below maps 1:1 onto an image pixel. If the
   * frame is ever re-cut, re-measure rather than re-eyeball: these four
   * percentages are the whole contract between the artwork and the UI.
   *
   * The Dynamic Island is part of the artwork (opaque at y 37..73), so nothing
   * here draws it - the screen simply runs underneath. */
  .phone {
    --ap-top: 2.5%; /* 23/920 */
    --ap-right: 5.3333%; /* 24/450 */
    --ap-bottom: 2.5%;
    --ap-left: 5.3333%;

    position: relative;
    width: 100%;
    aspect-ratio: 450 / 920;
    /* Makes cqw below resolve against THIS box. */
    container-type: inline-size;

    /* App light mode, verbatim from apps/mobile/src/constants/theme.ts. */
    --ph-text: #1c1c1e;
    --ph-bg: #ffffff;
    --ph-elem: #f2f2f7;
    --ph-sel: #e5e5ea;
    --ph-sec: #6b6b70;
    --ph-red: #ff3b30;
    --ph-blue: #0a84ff;
    --ph-in: #e9e9eb;

    /* SF where it exists, the product's own UI face everywhere else - closer
     * to SF than a stock Android or Windows system face would be. */
    font-family: -apple-system, BlinkMacSystemFont, var(--ff-app), sans-serif;
    color: var(--ph-text);
    text-align: left;
    /* These visuals resize their own children on a loop; nothing here is
     * content a reader is tracking, so nothing here should anchor a scroll. */
    overflow-anchor: none;
    /* Every control here is a label. A tap that drags a pixel selects the
     * label's text instead of activating it, which on a touch screen is most
     * taps - and the transcript is decorative, so there is nothing to lose. */
    -webkit-user-select: none;
    user-select: none;
  }

  /* The radios are the state. Off-screen rather than display:none so the
   * :checked selectors still resolve. */
  .pr {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
    margin: 0;
  }

  .screen {
    position: absolute;
    inset: var(--ap-top) var(--ap-right) var(--ap-bottom) var(--ap-left);
    /* The 17 Pro's screen radius. Points, not a percentage: a percentage
     * radius on a non-square box needs two axes and drifts as the aspect
     * changes, and this box has a fixed point size. */
    border-radius: calc(62 * var(--pu));
    overflow: hidden;
    background: var(--ph-bg);
    isolation: isolate;
  }

  /* ONE iOS POINT, and the reason nothing in this file reads the viewport.
   *
   * Declared on .phone's CHILDREN, never on .phone itself. Two reasons, both
   * load-bearing: a container unit queried from the container element is not
   * reliably that element's own size, and a percentage inside a custom
   * property is substituted TEXTUALLY - so a `--pu` built from `100%` would
   * resolve against the parent font-size the moment it was used in
   * `font-size`, which is most of this stylesheet. From a child, 1cqw is
   * unambiguously 1% of .phone's width.
   *
   * The screen is 402pt across and spans 100% - 5.3333% - 5.3333% = 89.3333%
   * of the frame, so 1pt = 0.893333/402 cqw. It inherits from .screen into
   * every rule below. */
  .screen,
  .shadow,
  .frame {
    --pu: 0.222222cqw;
  }

  /* The body's silhouette: x 8..441 of 450, y 7..912 of 920 - pulled 3pt
   * inside it on every edge, and rounder than it looks.
   *
   * The artwork's corner is a CONTINUOUS curve, not a circular arc: measured
   * off the alpha channel it runs 68px along the top edge but 76px down the
   * side. A CSS circular radius matching the smaller of those is squarer than
   * the real corner at the diagonal, so the blurred silhouette escaped past
   * the bezel and read as a grey rounded rectangle sitting behind the phone.
   * 80pt plus the inset keeps it inside the body all the way round; a shadow
   * only has to stay within the shape, not trace it. */
  .shadow {
    position: absolute;
    inset: calc(0.761% + 3 * var(--pu)) calc(1.778% + 3 * var(--pu));
    border-radius: calc(80 * var(--pu));
    box-shadow:
      0 calc(30 * var(--pu)) calc(60 * var(--pu)) rgb(0 0 0 / 0.45),
      0 calc(6 * var(--pu)) calc(16 * var(--pu)) rgb(0 0 0 / 0.32);
  }

  /* The device artwork, painted over the screen through its own cut-out. */
  .frame {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /* The artwork is loaded ONLY where the phone is shown. A background-image
   * declared inside an unmatched media query is never fetched, so a desktop
   * visitor - who gets AppDemo's window instead - does not pay for it. An
   * <img> in a display:none subtree would still be requested, which is why
   * the frame is a background rather than an element. */
  @media (max-width: 40rem) {
    .frame {
      background: url("/iphone.png") center / 100% 100% no-repeat;
    }
  }

  /* ── Liquid Glass ─────────────────────────────────────────────────────────
   *
   * iOS 26/27's material is four things stacked, and only the first is a
   * one-liner in CSS:
   *
   *   1. a blurred, saturated backdrop                       - backdrop-filter
   *   2. a tint that reads as glass, not as a grey chip      - background
   *   3. a specular rim, brightest where the light lands     - the ::after ring
   *   4. REFRACTION: content near the edge displaced inward  - see below
   *
   * (4) is the one that makes Apple's version look wet, and it is the one the
   * web cannot do here. The technique the articles describe - an SVG
   * feDisplacementMap fed to `backdrop-filter: url(#…)` - is Chromium-only:
   * Safari does not support SVG filters in backdrop-filter at all, and this
   * demo renders on phones, which is overwhelmingly iOS Safari. It would be
   * complexity spent on an effect our actual audience never sees, so the rim
   * below fakes the edge lensing instead: a gradient ring, bright at the two
   * corners the light would catch and nearly gone along the sides. That is
   * what reads as a bevel picking up light.
   *
   * The tint is Apple's systemFill grey rather than a translucent white. Over
   * the white feed a white tint renders as… white; the grey is what produces
   * the light-grey pill the reference crop actually shows. */
  .glass {
    position: relative;
    isolation: isolate;
    background: rgb(120 120 128 / 0.08);
    -webkit-backdrop-filter: blur(calc(13 * var(--pu))) saturate(190%) brightness(1.04);
    backdrop-filter: blur(calc(13 * var(--pu))) saturate(190%) brightness(1.04);
    box-shadow:
      /* Lift off the surface behind it. */
      0 calc(0.5 * var(--pu)) calc(1.5 * var(--pu)) rgb(0 0 0 / 0.05),
      0 calc(5 * var(--pu)) calc(13 * var(--pu)) rgb(0 0 0 / 0.09),
      /* An inner floor - without it the lower half reads as flat fill. */
      inset 0 calc(-1 * var(--pu)) calc(2 * var(--pu)) rgb(0 0 0 / 0.045);
  }

  /* The rim. Drawn as a ring - a padding-box mask XORed against the border box
   * leaves only the perimeter - so the gradient can vary AROUND the edge the
   * way a real bevel's highlight does, which a plain inset box-shadow cannot.
   * 150deg puts the two bright arcs at upper-left and lower-right. */
  .glass::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 2;
    border-radius: inherit;
    padding: calc(1 * var(--pu));
    background: linear-gradient(
      150deg,
      rgb(255 255 255 / 1) 0%,
      rgb(255 255 255 / 0.4) 26%,
      rgb(255 255 255 / 0.1) 48%,
      rgb(255 255 255 / 0.46) 70%,
      rgb(255 255 255 / 0.96) 100%
    );
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask-composite: exclude;
    pointer-events: none;
  }

  /* ── Status bar ── */

  .sbar {
    position: absolute;
    inset: 0 0 auto;
    z-index: 4;
    height: calc(62 * var(--pu));
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: calc(14 * var(--pu)) calc(34 * var(--pu)) 0;
    font-size: calc(16 * var(--pu));
    font-weight: 600;
    letter-spacing: calc(-0.2 * var(--pu));
  }

  .sright {
    display: inline-flex;
    align-items: center;
    gap: calc(6 * var(--pu));
  }

  .sglyph {
    display: block;
  }

  .scell {
    width: calc(17.5 * var(--pu));
  }

  .swifi {
    width: calc(17.5 * var(--pu));
  }

  .sglyph :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  .sbatt {
    width: calc(27 * var(--pu));
  }

  /* ── View switching ───────────────────────────────────────────────────────
   * One rule per conversation. Verbose by necessity: an id-keyed :checked
   * selector cannot be generated from the array, and the alternative (a script
   * that toggles classes) would trade a static page for a hydrated one. */
  .listview,
  .chatview {
    position: absolute;
    inset: 0;
    display: none;
    flex-direction: column;
  }

  #ph-list:checked ~ .screen .listview,
