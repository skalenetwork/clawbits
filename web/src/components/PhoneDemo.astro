  .ldiv {
    position: absolute;
    left: calc(70 * var(--pu));
    right: 0;
    bottom: 0;
    height: 1px;
    background: var(--ph-sel);
  }

  /* ── 2 · Conversation ── */

  .cfeed {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
    /* Clears the floating nav bar and the composer; the feed itself runs
     * edge to edge underneath both.
     *
     * The bottom pad also carries the crop. The stack is bottom-anchored, so
     * without this the newest messages - the ones the conversation is being
     * shown FOR - sit in the band the canvas cuts away, and the phone reads as
     * open on the oldest part of the thread. */
    padding-top: calc(120 * var(--pu));
    padding-inline: calc(12 * var(--pu));
    /* Clear the composer, OR clear the crop plus a breath - whichever is
     * further. Once the canvas cuts deeply enough to take the composer with
     * it, clearing the composer stops meaning anything and the crop line is
     * what the last message has to sit above.
     *
     * --ph-crop is set on .stage in index.astro and inherits down. It is read
     * with a fallback rather than defaulted on .phone: a declaration here would
     * shadow the inherited value, which is exactly the bug this replaced. */
    padding-bottom: max(
      calc(104 * var(--pu)),
      calc((var(--ph-crop, 0) + 20) * var(--pu))
    );
  }

  /* No gap: the spacing is per-row, because it is not uniform - see .crow. */
  .cstack {
    display: flex;
    flex-direction: column;
  }

  .cday {
    align-self: center;
    margin: calc(10 * var(--pu)) 0 calc(6 * var(--pu));
    font-size: calc(12 * var(--pu));
    font-weight: 500;
    color: var(--ph-sec);
  }

  /* message-bubble.tsx: rowFirst marginTop 8, rowTight marginTop 2. A new
   * speaker gets air; a run from the same one stays welded together, which is
   * what makes a streak read as one utterance broken over several bubbles. A
   * flat gap on the stack gave everything the tight value. */
  /* The day dividers stay in the data - the desktop window shows the whole
   * engineering thread and needs them - but the phone opens mid-thread on a
   * cropped screen, where "Today" lands in the very first frame as a label
   * dating a boundary the reader cannot see. Hidden for the opening
   * conversation only; every other chat on the phone keeps its dividers. */
  .cv-eng .cday {
    display: none;
  }

  .crow {
    display: flex;
    align-items: flex-end;
    gap: calc(4 * var(--pu));
    margin-top: calc(8 * var(--pu));
  }

  .crow.tight {
    margin-top: calc(2 * var(--pu));
  }

  .crow.own {
    justify-content: flex-end;
  }

  /* Channel incoming rows reserve the avatar gutter whether or not this
   * particular bubble ends the streak - otherwise the run steps sideways. */
  .crow.gut {
    padding-left: calc(32 * var(--pu));
  }

  .crow.gut:has(.cgav) {
    padding-left: 0;
  }

  .cgav {
    flex: none;
    width: calc(28 * var(--pu));
    height: calc(28 * var(--pu));
    border-radius: 999px;
    object-fit: cover;
    background: rgb(0 0 0 / 0.13);
  }

  .cgletter {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: calc(13 * var(--pu));
    font-weight: 600;
    font-style: normal;
    color: var(--ph-sec);
  }

  .cbub {
    max-width: 78%;
    display: flex;
    flex-direction: column;
    gap: calc(6 * var(--pu));
    padding: calc(8 * var(--pu)) calc(14 * var(--pu));
    border-radius: calc(18 * var(--pu));
    background: var(--ph-in);
    overflow: hidden;
  }

  .crow.own .cbub {
    background: var(--ph-blue);
    color: #fff;
  }

  /* The 5pt tail corner, on the last bubble of a streak only. */
  .crow.in.tail .cbub {
    border-bottom-left-radius: calc(5 * var(--pu));
  }

  .crow.own.tail .cbub {
    border-bottom-right-radius: calc(5 * var(--pu));
  }

  .csender {
    font-size: calc(12 * var(--pu));
    font-weight: 600;
    margin-bottom: calc(-2 * var(--pu));
    color: var(--ph-sec);
  }

  .ctext {
    font-size: calc(17 * var(--pu));
    line-height: calc(22 * var(--pu));
    letter-spacing: calc(-0.2 * var(--pu));
  }

  .ctext :global(p) {
    margin: 0;
  }

  .ctext :global(p + p) {
    margin-top: calc(8 * var(--pu));
  }

  .ctext :global(.lnk) {
    color: var(--ph-blue);
  }

  .crow.own .ctext :global(.lnk) {
    color: #fff;
    text-decoration: underline;
  }

  .ctext :global(.mention) {
    font-weight: 600;
    color: var(--ph-blue);
  }

  /* An image-only message IS the bubble: no padding, and the picture runs the
   * bubble's full width so the bubble's own radius (tail corner included) is
   * what rounds the photo. That is why the real bubble keeps `padding: 0` and
   * hangs its padding on an inner column.
   *
   * `width: 100%` here means 100% of the ROW, which the bubble's existing
   * max-width caps at 78% - the same ceiling every other bubble gets. Sizing
   * the image to a fixed width instead left it floating in a bubble wider than
   * itself, with a strip of bare fill down one side. */
  .cbub:has(> .cimg) {
    padding: 0;
    width: 100%;
  }

  /* …which leaves the sender name, when there is one, with no padding of its
   * own. The real bubble solves this by keeping `padding: 0` and hanging the
   * padding on an inner column that the image grid sits outside of; one rule
   * is cheaper than restructuring the markup for it. */
  .cbub:has(> .cimg) .csender {
    padding: calc(8 * var(--pu)) calc(14 * var(--pu)) 0;
  }

  .cimg {
    display: block;
    width: 100%;
    height: auto;
  }

  .cfile {
    display: flex;
    align-items: center;
    gap: calc(8 * var(--pu));
    padding: calc(6 * var(--pu)) 0;
  }

  .cfico {
    flex: none;
    width: calc(16 * var(--pu));
    opacity: 0.7;
  }

  .cfico :global(svg),
  .cbico :global(svg),
  .cnchev :global(svg),
  .cmic :global(svg),
  .cbtn :global(svg),
  .tbtn i :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  .cfbody {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .cfbody b {
    font-size: calc(14 * var(--pu));
    font-weight: 600;
  }

  .cfbody em {
    font-size: calc(12 * var(--pu));
    font-style: normal;
    opacity: 0.7;
  }

  /* The link preview, hung under the text inside the bubble.
   *
   * A card NESTED in the bubble, not a full-bleed panel across it -
   * link-preview-card.tsx: radius 16, marginTop 8, overflow hidden, OG image
   * across the top at 1.91:1, inner padding 14/12 under it. It keeps the
   * bubble's own 14pt inset on both sides, and the clip is what rounds the
   * lockup's top corners with the card. */
  .ccard {
    display: block;
    margin-top: calc(8 * var(--pu));
    border-radius: calc(16 * var(--pu));
    overflow: hidden;
    background: #fff;
    color: var(--ph-text);
  }

  .ccard-top {
    display: block;
    padding: calc(11 * var(--pu)) calc(14 * var(--pu)) calc(12 * var(--pu));
  }

  /* Two lines, then ellipsis - the real card's line-clamp-2. The release
   * title is long enough to need it at this width. */
  .ccard-top b {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    font-size: calc(15 * var(--pu));
    line-height: calc(19 * var(--pu));
    font-weight: 700;
  }

  .ccard-top em {
    display: block;
    margin-top: calc(3 * var(--pu));
    font-size: calc(12 * var(--pu));
    line-height: calc(16 * var(--pu));
    font-style: normal;
    color: var(--ph-sec);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .creacts {
    display: flex;
    flex-wrap: wrap;
    gap: calc(5 * var(--pu));
  }

  .creact {
    display: inline-flex;
    align-items: center;
    gap: calc(5 * var(--pu));
    padding: calc(4 * var(--pu)) calc(10 * var(--pu));
    border-radius: 999px;
    background: rgb(255 255 255 / 0.75);
    font-size: calc(13 * var(--pu));
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--ph-text);
  }

  .creact i {
    font-size: calc(15 * var(--pu));
    font-style: normal;
  }

  .crow.in .creact {
    background: rgb(255 255 255 / 0.9);
  }

  /* Soft scroll edges. Sit above the feed and below the floating chrome. */
  .cveil {
    position: absolute;
    inset: 0 0 auto;
    z-index: 2;
    height: calc(100 * var(--pu));
    /* Opaque past the status bar, then a short fade that is done before the
     * nav pill's lower edge. The pill carries its own glass, so the veil only
     * has to clear the STATUS bar - running it the full depth of the nav put a
     * band of white a third of the way down the screen. */
    background: linear-gradient(
      to bottom,
      rgb(255 255 255 / 0.9) 44%,
      rgb(255 255 255 / 0.7) 74%,
      rgb(255 255 255 / 0) 100%
    );
    pointer-events: none;
  }

  .cveil-b {
    inset: auto 0 0;
    height: calc(118 * var(--pu));
    background: linear-gradient(
      to top,
      var(--ph-bg) 44%,
      rgb(255 255 255 / 0.8) 74%,
      rgb(255 255 255 / 0) 100%
    );
  }

  /* ── Conversation nav bar ── */

  .chead {
    position: absolute;
    inset: calc(62 * var(--pu)) 0 auto;
    z-index: 3;
    display: flex;
    align-items: flex-start;
    padding: 0 calc(14 * var(--pu));
    height: calc(58 * var(--pu));
  }

  .cback {
    display: inline-flex;
    align-items: center;
    gap: calc(4 * var(--pu));
    padding: calc(9 * var(--pu)) calc(12 * var(--pu));
    border-radius: 999px;
    cursor: pointer;
  }

  .cbico {
    display: block;
    width: calc(18 * var(--pu));
  }

  .cbbadge {
    min-width: calc(22 * var(--pu));
    padding: calc(1 * var(--pu)) calc(7 * var(--pu));
    border-radius: 999px;
    background: rgb(255 255 255 / 0.9);
    font-size: calc(12 * var(--pu));
    font-weight: 600;
    font-style: normal;
    font-variant-numeric: tabular-nums;
    text-align: center;
  }

  /* The contact-card title column: avatar over a glass name pill. */
  .ctitle {
    position: absolute;
    left: 50%;
    top: 0;
    translate: -50% calc(-4 * var(--pu));
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .ctav {
    width: calc(46 * var(--pu));
    height: calc(46 * var(--pu));
    border-radius: 999px;
    object-fit: cover;
    translate: 0 calc(-3 * var(--pu));
    z-index: 2;
    background: var(--ph-sel);
  }

  .cnamepill {
    display: inline-flex;
    align-items: center;
    gap: calc(5 * var(--pu));
    /* chat-header.tsx has -6; pulled tighter so the pill tucks under the
     * avatar rather than sitting below it. */
    margin-top: calc(-9 * var(--pu));
    padding: calc(5 * var(--pu)) calc(14 * var(--pu));
    border-radius: 999px;
  }

  .cname {
    max-width: calc(200 * var(--pu));
    font-size: calc(15 * var(--pu));
    font-weight: 600;
    letter-spacing: calc(-0.1 * var(--pu));
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .cnchev {
    display: block;
    width: calc(10 * var(--pu));
    opacity: 0.55;
  }

  /* ── Composer ── */

  .ccomposer {
    position: absolute;
    inset: auto 0 0;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: calc(8 * var(--pu));
    padding: calc(8 * var(--pu)) calc(12 * var(--pu)) calc(34 * var(--pu));
  }

  .cbtn {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: calc(44 * var(--pu));
    height: calc(44 * var(--pu));
    padding: calc(11 * var(--pu));
    border-radius: 999px;
  }

  .cinput {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: calc(6 * var(--pu));
    min-height: calc(44 * var(--pu));
    padding: calc(5 * var(--pu)) calc(5 * var(--pu)) calc(5 * var(--pu)) calc(16 * var(--pu));
    border-radius: calc(22 * var(--pu));
  }

  .cph {
    flex: 1;
    min-width: 0;
    font-size: calc(17 * var(--pu));
    line-height: calc(22 * var(--pu));
    letter-spacing: calc(-0.2 * var(--pu));
    color: var(--ph-sec);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* A typed draft is the user's own ink, not a placeholder. */
  .cv-eng .cph,
  .cv-quill .cph {
    color: var(--ph-text);
  }

  .cmic {
    flex: none;
    width: calc(22 * var(--pu));
    margin-right: calc(9 * var(--pu));
    color: var(--ph-sec);
  }

  /* ── 3 · iOS 26 tab bar ── */

  .tabbar {
    position: absolute;
    inset: auto calc(16 * var(--pu)) calc(26 * var(--pu));
    z-index: 5;
    display: none;
    align-items: center;
    padding: calc(6 * var(--pu));
    border-radius: 999px;
  }

  #ph-list:checked ~ .screen .tabbar {
    display: flex;
  }

  .tbtn {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: calc(3 * var(--pu));
    padding: calc(6 * var(--pu)) 0;
    border-radius: 999px;
    color: var(--ph-sec);
  }

  .tbtn i {
    display: block;
    width: calc(22 * var(--pu));
  }

  .tbtn b {
    font-size: calc(10 * var(--pu));
    font-weight: 500;
    letter-spacing: calc(-0.1 * var(--pu));
  }

  /* iOS 26 paints the selected tab as a filled capsule, tinted to the scheme -
   * near-black on a dark UI, a light fill with dark contents on a light one.
   * This demo is light mode, so it is the latter. */
  .tbtn.on {
    background: rgb(120 120 128 / 0.16);
    color: var(--ph-text);
  }


  /* ── The details sheet ────────────────────────────────────────────────────
   *
   * iOS 26's presentation, as far as CSS can take it:
   *
   *   1. the presenting view scales back behind a dim   - .cstage
   *   2. the sheet rises from the bottom on glass       - .sheet
   *   3. its controls are the same material as the bar  - .glass, reused
   *
   * The screen is CROPPED by the hero canvas (--ph-crop, index.astro), so a
   * bottom sheet in the usual sense - anchored to the chin, growing upward -
   * would be entirely below the fold. This one is anchored to the TOP instead:
   * 66pt down, running past the crop, with everything that has to be read in
   * the first ~570pt. That is also how a full-height iOS sheet behaves, so the
   * constraint and the reference agree.
   */

  /* The conversation, so it can be pushed back as a unit. Nothing about it
   * changes while the sheet is closed - `scale` is left at its initial `none`
   * rather than written as 1, so the chat does not carry a stacking context
   * and a containing block it has no use for. */
  .cstage {
    position: absolute;
    inset: 0;
    transform-origin: 50% 0%;
  }

  @media (prefers-reduced-motion: no-preference) {
    .cstage {
      transition:
        scale 460ms var(--ease-out-expo),
        translate 460ms var(--ease-out-expo),
        filter 460ms var(--ease-out-expo);
    }
  }

  #ph-det:checked ~ .screen .cstage {
    scale: 0.93;
    translate: 0 calc(12 * var(--pu));
    /* Corners, because a scaled-back view with square ones reads as a
     * mis-sized screen rather than as a card behind a sheet. */
    border-radius: calc(40 * var(--pu));
    overflow: hidden;
    /* Not opacity: the sheet's own backdrop-filter samples whatever is behind
     * it, and a half-transparent chat over the white screen turns the glass
     * into flat white. Desaturating leaves something for it to pick up. */
    filter: saturate(0.75) brightness(0.94);
  }

  .sdim,
  .sheet {
    display: none;
  }

  #ph-det:checked ~ .screen .sdim {
    display: block;
  }

  #ph-det:checked ~ .screen .sheet {
    display: flex;
  }

  .sdim {
    position: absolute;
    inset: 0;
    z-index: 8;
    background: rgb(0 0 0 / 0.3);
    cursor: pointer;
  }

  .sheet {
    position: absolute;
    inset: calc(66 * var(--pu)) 0 0;
    z-index: 9;
    flex-direction: column;
    border-radius: calc(44 * var(--pu)) calc(44 * var(--pu)) 0 0;
    overflow: hidden;
    /* systemGroupedBackground, thinned so the pushed-back chat shows through
     * as light and colour rather than as a picture. */
    background: rgb(244 244 248 / 0.82);
    -webkit-backdrop-filter: blur(calc(26 * var(--pu))) saturate(180%);
    backdrop-filter: blur(calc(26 * var(--pu))) saturate(180%);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.75),
      0 calc(-8 * var(--pu)) calc(30 * var(--pu)) rgb(0 0 0 / 0.14);
  }

  /* Longhands, never the `animation` shorthand - see the scroll-timeline note
   * at the foot of this file for what the minifier does to it. */
  @media (prefers-reduced-motion: no-preference) {
    #ph-det:checked ~ .screen .sheet {
      animation-name: ph-sheet-in;
      animation-duration: 460ms;
      animation-timing-function: var(--ease-out-expo);
      animation-fill-mode: both;
    }

    #ph-det:checked ~ .screen .sdim {
      animation-name: ph-dim-in;
      animation-duration: 300ms;
      animation-timing-function: ease-out;
      animation-fill-mode: both;
    }
  }

  @keyframes ph-sheet-in {
    from {
      translate: 0 100%;
    }
  }

  @keyframes ph-dim-in {
    from {
      opacity: 0;
    }
  }

  .sgrab {
    align-self: center;
    width: calc(38 * var(--pu));
    height: calc(5 * var(--pu));
    margin-top: calc(8 * var(--pu));
    border-radius: 999px;
    background: rgb(60 60 67 / 0.3);
  }

  .shead {
    display: flex;
    justify-content: flex-end;
    padding: calc(6 * var(--pu)) calc(16 * var(--pu)) 0;
  }

  .sdone {
    padding: calc(7 * var(--pu)) calc(16 * var(--pu));
    border-radius: 999px;
    font-size: calc(15 * var(--pu));
    font-weight: 600;
    color: var(--ph-blue);
    cursor: pointer;
  }

  /* ── Who this is ── */

  .shero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: calc(3 * var(--pu));
    padding: calc(2 * var(--pu)) calc(20 * var(--pu)) calc(20 * var(--pu));
  }

  .shava {
    width: calc(92 * var(--pu));
    height: calc(92 * var(--pu));
    margin-bottom: calc(10 * var(--pu));
    border-radius: 999px;
    object-fit: cover;
    background: var(--ph-sel);
  }

  .shname {
    font-size: calc(26 * var(--pu));
    font-weight: 700;
    letter-spacing: calc(-0.5 * var(--pu));
  }

  .shline {
    font-size: calc(14 * var(--pu));
    color: var(--ph-sec);
  }

  /* ── Actions: four equal columns of glass ── */

  .sacts {
    display: flex;
    gap: calc(12 * var(--pu));
    padding: 0 calc(20 * var(--pu));
  }

  .sact {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: calc(6 * var(--pu));
  }

  .sactic {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: calc(52 * var(--pu));
    border-radius: calc(18 * var(--pu));
    color: var(--ph-blue);
  }

  /* A fixed glyph in a wide button: the shared "svg fills its box" rule the
   * rest of this file uses is for icons whose box IS the icon, and these
   * buttons are 74pt wide capsules holding a 24pt symbol. */
  .sactic :global(svg) {
    display: block;
    width: calc(24 * var(--pu));
    height: auto;
  }

  .fchev :global(svg),
  .fdoc :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  .sact em {
    font-size: calc(11 * var(--pu));
    font-style: normal;
    font-weight: 500;
    color: var(--ph-sec);
  }

  /* ── Tabs: the same capsule the list's scope tabs use ── */

  .stabs {
    display: flex;
    gap: calc(4 * var(--pu));
    margin: calc(20 * var(--pu)) calc(20 * var(--pu)) 0;
    padding: calc(4 * var(--pu));
    border-radius: 999px;
  }

  .stab {
    flex: 1;
    min-height: calc(32 * var(--pu));
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    font-size: calc(13 * var(--pu));
    font-weight: 600;
    color: var(--ph-sec);
    cursor: pointer;
  }

  #ph-dt-info:checked ~ .screen label[for="ph-dt-info"],
  #ph-dt-files:checked ~ .screen label[for="ph-dt-files"] {
    background: rgb(255 255 255 / 0.9);
    color: var(--ph-text);
  }

  .spane {
    display: none;
    padding: calc(16 * var(--pu)) calc(20 * var(--pu)) 0;
  }

  #ph-dt-info:checked ~ .screen .sp-info,
  #ph-dt-files:checked ~ .screen .sp-files {
    display: block;
  }

  /* The grouped inset card every iOS settings list is made of. */
  .scard {
    border-radius: calc(16 * var(--pu));
    background: rgb(255 255 255 / 0.86);
    overflow: hidden;
  }

  .srow {
    position: relative;
    display: flex;
    align-items: center;
    gap: calc(12 * var(--pu));
    min-height: calc(44 * var(--pu));
    padding: calc(9 * var(--pu)) calc(16 * var(--pu));
    font-size: calc(15 * var(--pu));
  }

  /* Hairline between rows, inset to the text - not under the leading edge. */
  .srow + .srow::before {
    content: "";
    position: absolute;
    left: calc(16 * var(--pu));
    right: 0;
    top: 0;
    height: 1px;
    background: rgb(60 60 67 / 0.13);
  }

  .frow + .frow::before {
    left: calc(72 * var(--pu));
  }

  .srk {
    flex: none;
    color: var(--ph-sec);
  }

  .srv {
    flex: 1;
    min-width: 0;
    text-align: right;
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ── Attachments ── */

  .fthumb {
    flex: none;
    width: calc(44 * var(--pu));
    height: calc(44 * var(--pu));
    border-radius: calc(11 * var(--pu));
    object-fit: cover;
    background: var(--ph-sel);
  }

  .fdoc {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: calc(10 * var(--pu));
    background: rgb(10 132 255 / 0.12);
    color: var(--ph-blue);
  }

  .fbody {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: calc(1 * var(--pu));
  }

  .fbody b {
    font-size: calc(15 * var(--pu));
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .fbody em {
    font-size: calc(12 * var(--pu));
    font-style: normal;
    color: var(--ph-sec);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .fchev {
    flex: none;
    width: calc(9 * var(--pu));
    color: rgb(60 60 67 / 0.3);
  }

  .sempty {
    padding: calc(28 * var(--pu)) 0;
    text-align: center;
    font-size: calc(14 * var(--pu));
    color: var(--ph-sec);
  }

  /* ── Scrolling, without ever taking the gesture ───────────────────────────
   *
   * The obvious way to make these views scroll is `overflow-y: auto`. Do not.
   * On iOS Safari a nested scroller CLAIMS the whole touch gesture: when it
   * reaches its end the page does not take over, it stops, and the reader has
   * to lift and touch again to carry on down the page. There is no CSS fix -
   * `overscroll-behavior` governs the opposite problem, stopping chaining
   * rather than forcing it - and nothing hands a gesture back mid-flight. A
   * demo that traps the reader on the way to the rest of the page is worse
   * than one that never moves.
   *
   * So the page stays the only scroller and the feed is driven FROM it. Over
   * the first 380px of the document the conversation runs from older messages
   * down to the newest, exactly as if it were being scrolled; after that it is
   * settled and stays settled. The gesture is never intercepted, so the page
   * never stops - it just happens to be scrolling two things at once for a
   * moment.
   *
   * A ROOT scroll timeline, not a view timeline on the phone: a view range
   * resolves against the viewport's height, so the same `cover 30%` lands at a
   * different page offset on every device, and the point where the feed
   * settles is exactly the point the crop was tuned around. An absolute
   * document offset puts that moment in the same place for everyone.
   *
   * Behind @supports because a browser without scroll-driven animations must
   * get the resting layout, not an animation with no timeline to sit on. */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      /* LONGHANDS ONLY, and never the `animation` shorthand.
       *
       * `animation: linear both` has no name, so a minifier is free to fold it
       * to `animation: none` - and because the shorthand also RESETS
       * animation-timeline, Lightning CSS took the timeline declaration with
       * it. Staging shipped `animation:none;animation-range:0 210px` and no
       * timeline at all, which is why the feed sat at its resting position on
       * the device while working perfectly in `astro dev` (which does not
       * minify). Verify this rule against `bun run build` output, not dev.
       *
       * `animation-duration: auto` is also load-bearing: it is what maps an
       * animation across a scroll range. The shorthand's omitted duration
       * resolves to 0s in some engines, which finishes the animation instantly
       * at the start of the range - the same wrong-looking result, arrived at
       * a different way. */
      .cstack,
      .lcard {
        animation-duration: auto;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: scroll(root block);
        animation-range: 0px 210px;
      }

      .cstack {
        animation-name: ph-feed;
      }

      .lcard {
        animation-name: ph-list;
      }
    }
  }

  /* The opening frame, as a plain static value. Without this a browser that
   * cannot run scroll-driven animations - or a build that loses the timeline,
   * as staging did - falls back to translate 0, which is the END of the
   * thread. Now the fallback is the composition we actually designed; it just
   * does not move. */
  .cstack {
    translate: 0 calc(232 * var(--pu));
  }

  /* Bottom-anchored, so pushing the stack DOWN reveals earlier messages. */
  @keyframes ph-feed {
    from {
      /* Opens on the TAIL of Priya's photo - a band of court under the nav
       * bar, not the whole picture. Enough that the thread visibly has an
       * attachment in it and that there is somewhere to scroll from; not so
       * much that the hero's first frame is a photograph rather than a
       * conversation.
       *
       * High enough, with the trimmed release note, that atlas's avatar lands
       * inside the first frame: a streak's avatar hangs off the BOTTOM of its
       * last bubble, so anything that lengthens that bubble pushes the one
       * mark identifying the speaker below the fold.
       *
       * The two pull against each other: the court band and atlas's avatar sit
       * about 58pt further apart than the opening frame is tall, so the sliver
       * of photo is as thin as it is BECAUSE the avatar has to clear. Measured
       * against a 812pt-tall viewport; a materially shorter phone loses the
       * avatar again, and the honest fix for that would be a shorter bubble,
       * not a deeper offset.
       *
       * ~175px of feed over the 210px range below, so the chat tracks the
       * finger close to 1:1 - which is what makes it read as scrolling rather
       * than as parallax. */
      translate: 0 calc(232 * var(--pu));
    }
    to {
      translate: 0 0;
    }
  }

  /* The list is top-anchored, so it runs the other way: down the rows. */
  @keyframes ph-list {
    from {
      translate: 0 0;
    }
    to {
      translate: 0 calc(-110 * var(--pu));
    }
  }
</style>
