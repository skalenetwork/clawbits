    display: flex;
    align-items: flex-start;
    gap: calc(12 * var(--pu));
    padding-block: calc(10 * var(--pu));
    cursor: pointer;
  }

  /* 58pt at radius 15 - the squircle the whole list is built on. */
  .lava {
