            </div>

            <div class="spane sp-info">
              <div class="scard">
                {aboutOf(c).rows.map(([k, v]) => (
                  <span class="srow">
                    <span class="srk">{k}</span>
                    <span class="srv">{v}</span>
                  </span>
                ))}
              </div>
            </div>

