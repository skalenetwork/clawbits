    display: block;
    width: 100%;
    height: auto;
  }

  .lmeta {
    position: absolute;
    right: 0;
    top: calc(12 * var(--pu));
    width: calc(60 * var(--pu));
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: calc(10 * var(--pu));
  }

  .ltime {
