  .rbtn:hover,
  label.pin:hover {
    background: rgb(30 30 30 / 0.05);
    color: var(--ink);
  }

  .rbtn.still {
    cursor: default;
  }

  #v-home:checked ~ .body label[for="v-home"],
  #v-agents:checked ~ .body label[for="v-agents"],
  #v-hermes:checked ~ .body label.pin[for="v-hermes"],
  #v-allhands:checked ~ .body label.pin[for="v-allhands"],
  #v-eng:checked ~ .body label.pin[for="v-eng"],
  #v-mara:checked ~ .body label.pin[for="v-mara"],
  #v-smartclaws:checked ~ .body label.pin[for="v-smartclaws"],
  #v-scout:checked ~ .body label.pin[for="v-scout"] {
