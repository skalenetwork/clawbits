---
import { demoChats } from "../content/demo-chats";
import { getDesktopFacts } from "../lib/releases";
import { LINKS } from "../config";
import Sidebar from "./app-demo/Sidebar.astro";
import HomeView from "./app-demo/HomeView.astro";
import AgentsView from "./app-demo/AgentsView.astro";
import ChatView from "./app-demo/ChatView.astro";
import "./app-demo/demo.css";

/**
 * The hero's product frame: a sample-data recreation of the Clawbits macOS
 * desktop app in the light theme. Audit base: branch reef-v2-integration,
 * 2026-09-14. Ground rules, every metric and its frontend/src cite live in
 * clawbits-internal/docs/plans/APPDEMO_UPGRADE_PLAN.md; re-audit there before
 * fixing anything by eye.
 *
 * Views switch on one radio group, `demo-view`, whose radios sit inside their
 * sidebar rows; anything else that opens a view is a label into it.
 * Production CSP: no style attributes (set:html and innerHTML included), no
 * define:vars, no is:inline. Only processed scripts and styles.
 *
 * The release is the real latest desktop build, read from GitHub at build
 * time, so the #engineering thread and its link preview never go stale.
 */
const release = await getDesktopFacts();
const CHATS = demoChats(release.version);
---

<div class="win" role="group" aria-label="Clawbits app demo" data-signup={LINKS.signup}>
  <Sidebar chats={CHATS} />
  <div class="main">
    <HomeView chats={CHATS} />
    <AgentsView chats={CHATS} />
    {CHATS.map((c) => <ChatView chat={c} release={release} />)}
  </div>
</div>

<script>
  const win = document.querySelector<HTMLElement>(".win");

  /**
   * Chrome latches a wheel gesture to the scroller it started on, so a pane
   * scrolled to its end would freeze the page until the gesture stops. At a
   * boundary the event is cancelled and the page moves instead, 1:1 and
   * `instant`, because global.css sets smooth scrolling on the root.
   */
  win?.addEventListener(
    "wheel",
    (event) => {
      let node = event.target as HTMLElement | null;
      while (node && node !== win) {
        const { overflowY } = getComputedStyle(node);
        if ((overflowY === "auto" || overflowY === "scroll") && node.scrollHeight > node.clientHeight) break;
        node = node.parentElement;
      }
      if (!node || node === win) return;

      const atTop = node.scrollTop <= 0;
      const atEnd = node.scrollTop >= node.scrollHeight - node.clientHeight - 1;
      if (!((event.deltaY < 0 && atTop) || (event.deltaY > 0 && atEnd))) return;

      const dy =
        event.deltaMode === 1
          ? event.deltaY * 16
          : event.deltaMode === 2
            ? event.deltaY * window.innerHeight
            : event.deltaY;
      event.preventDefault();
      window.scrollBy({ top: dy, behavior: "instant" });
    },
    { passive: false },
  );
</script>

<style>
  /**
   * Composited descendants (backdrop blurs) escape a rounded overflow clip and
   * sample the hero behind the corners, so both columns carry the window
   * radius themselves.
   */
  .win {
    --win-radius: clamp(0.75rem, 1.7vw, 1.375rem);
    position: relative;
    display: flex;
    width: min(90.6%, 70.5rem);
    aspect-ratio: 1166 / 720;
    margin-inline: auto;
    overflow: hidden;
    border-radius: var(--win-radius);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.55),
      0 0 0 0.5px rgb(30 30 30 / 0.2),
      0 20px 25px -5px rgb(0 0 0 / 0.1),
      0 8px 10px -6px rgb(0 0 0 / 0.1);
    text-align: left;
  }

  .main {
    position: relative;
    flex: 1;
    min-width: 0;
    overflow: hidden;
    clip-path: inset(0 round 0 var(--win-radius) var(--win-radius) 0);
    background: var(--bg);
  }

  @media (max-width: 40rem) {
    .win {
      display: none;
    }
  }
</style>
