  }

  .prev-text {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .pfx {
    flex-shrink: 0;
    font-weight: 500;
  }

  .pfx-draft {
    flex-shrink: 0;
    font-weight: 500;
    color: #dc2626;
  }

  .clip {
    opacity: 0.7;
  }

  .row-side {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    justify-content: space-between;
    align-self: stretch;
    padding: 8px 0;
    flex-shrink: 0;
  }

  .row-side:has(> :last-child:first-child) {
    justify-content: center;
  }

  .row-time {
    font-size: 10px;
    line-height: 1;
    color: var(--mut);
    font-variant-numeric: tabular-nums;
  }

  .row-unread {
