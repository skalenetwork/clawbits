  .org-mark {
    width: 26px;
    height: 26px;
    border-radius: 8px;
    display: grid;
    place-items: center;
    background: rgb(30 30 30 / 0.1);
    color: var(--ink);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: -0.05em;
    text-transform: uppercase;
