  .pins {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }

  /* Rail unread pill: #FF3B30, 2px ring in the surface behind it. */
  .rail-badge {
    position: absolute;
    top: -4px;
    right: -4px;
    min-width: 16px;
    height: 16px;
    padding-inline: 4px;
    border-radius: 999px;
    background: var(--unread);
    color: #fff;
    font-style: normal;
    font-size: 10px;
    font-weight: 600;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    display: grid;
