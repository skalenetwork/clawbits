  }

  .side-title {
    font-size: 14px;
    font-weight: 600;
  }

  /* Compose: a real 24px bordered square, not a bare glyph. */
  .side-new {
    width: 24px;
    height: 24px;
    border-radius: 8px;
    border: 1px solid var(--line);
    display: grid;
    place-items: center;
    color: var(--mut);
  }

  /* ── All/Channels/DMs segmented control (ChatTabs.tsx) ── */
  .tabs {
    display: flex;
    align-items: center;
    gap: 2px;
    margin: 8px 8px 6px;
    padding: 2px;
    border-radius: 10px;
    background: rgb(243 241 236 / 0.85);
  }

  .tab {
    flex: 1 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    padding: 6px 8px;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 500;
    white-space: nowrap;
    color: var(--mut);
    cursor: pointer;
    transition:
      background-color 100ms var(--ease-out-expo),
      color 100ms var(--ease-out-expo),
      scale 100ms var(--ease-out-expo);
  }

  /* Real tab states (ChatTabs.tsx): inactive hover 4% wash, press scale. */
  .tab:hover {
    background: rgb(30 30 30 / 0.04);
    color: var(--ink);
  }

  .tab:active {
    scale: 0.95;
  }

  #t-all:checked ~ .body label[for="t-all"],
  #t-ch:checked ~ .body label[for="t-ch"],
  #t-dm:checked ~ .body label[for="t-dm"] {
    background: rgb(30 30 30 / 0.08);
    color: var(--ink);
  }

  #t-all:focus-visible ~ .body label[for="t-all"],
  #t-ch:focus-visible ~ .body label[for="t-ch"],
  #t-dm:focus-visible ~ .body label[for="t-dm"] {
    outline: 2px solid var(--color-signal);
    outline-offset: 2px;
  }

  /* ── Tab filtering ──
   * Channels: channel rows only. DMs: humans + agents. Either way, if the
   * OPEN conversation is filtered out it lingers pinned above the list
   * with a hairline under it - the real sidebar's linger slot
   * (ChatsSidebar.tsx). */
  #t-ch:checked ~ .body .row.sp-human,
  #t-ch:checked ~ .body .row.sp-agent,
  #t-dm:checked ~ .body .row.sp-channel {
    display: none;
  }

  /* Linger: the open DM on the Channels tab… */
  #v-mara:checked ~ #t-ch:checked ~ .body label[for="v-mara"],
  #v-hermes:checked ~ #t-ch:checked ~ .body label[for="v-hermes"],
  #v-lena:checked ~ #t-ch:checked ~ .body label[for="v-lena"],
  #v-scout:checked ~ #t-ch:checked ~ .body label[for="v-scout"],
  #v-josh:checked ~ #t-ch:checked ~ .body label[for="v-josh"],
  #v-quill:checked ~ #t-ch:checked ~ .body label[for="v-quill"],
  #v-sasha:checked ~ #t-ch:checked ~ .body label[for="v-sasha"],
  /* …and the open channel on the DMs tab. */
  #v-allhands:checked ~ #t-dm:checked ~ .body label[for="v-allhands"],
  #v-eng:checked ~ #t-dm:checked ~ .body label[for="v-eng"],
  #v-clawbits:checked ~ #t-dm:checked ~ .body label[for="v-clawbits"],
  #v-smartclaws:checked ~ #t-dm:checked ~ .body label[for="v-smartclaws"],
  #v-pit:checked ~ #t-dm:checked ~ .body label[for="v-pit"] {
    display: flex;
    order: -2;
  }

  #v-mara:checked ~ #t-ch:checked ~ .body .linger-sep,
  #v-hermes:checked ~ #t-ch:checked ~ .body .linger-sep,
  #v-lena:checked ~ #t-ch:checked ~ .body .linger-sep,
  #v-scout:checked ~ #t-ch:checked ~ .body .linger-sep,
  #v-josh:checked ~ #t-ch:checked ~ .body .linger-sep,
  #v-quill:checked ~ #t-ch:checked ~ .body .linger-sep,
  #v-sasha:checked ~ #t-ch:checked ~ .body .linger-sep,
  #v-allhands:checked ~ #t-dm:checked ~ .body .linger-sep,
  #v-eng:checked ~ #t-dm:checked ~ .body .linger-sep,
  #v-clawbits:checked ~ #t-dm:checked ~ .body .linger-sep,
  #v-smartclaws:checked ~ #t-dm:checked ~ .body .linger-sep,
  #v-pit:checked ~ #t-dm:checked ~ .body .linger-sep {
    display: block;
    order: -1;
  }

  .linger-sep {
    display: none;
    height: 1px;
    flex-shrink: 0;
    margin: 2px 4px 4px;
    background: rgb(212 205 191 / 0.7);
  }

  /* ── Scrolling inside the window ──────────────────────────────────────────
   *
   * These four regions are real scroll containers and stay that way: reading a
   * conversation with the wheel is half of what makes the demo feel like an
   * app. What they are NOT allowed to do is trap the page.
   *
   * Chrome latches a wheel gesture to whichever scroller it started on, so
   * when the inner one bottoms out the page does not take over - it stops, and
   * the reader has to pause and re-scroll to get past the hero. `overscroll-
   * behavior` cannot fix that; it governs the opposite problem. The script
   * below does the hand-off the platform will not: at the boundary it cancels
   * the event and moves the page by the same delta, so one continuous gesture
   * reads the chat and then carries on down the page.
   *
   * Desktop only in practice - this window is display:none below 40rem, where
   * PhoneDemo takes over and refuses the gesture outright (touch cannot be
   * chained this way; see its own note).
   * ─────────────────────────────────────────────────────────────────────── */

  /* Scrollable like the real sidebar list, scrollbar hidden the same way
   * (ChatsSidebar.tsx: no-scrollbar overflow-y-auto). */
  .rows {
    min-height: 0;
    flex: 1;
    overflow-y: auto;
    scrollbar-width: none;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 0 8px 8px;
  }

  .rows::-webkit-scrollbar {
    display: none;
  }

  /* Rows: 48px, radius 10, 10px gaps (SidebarMenuButton size=lg). */
  .row {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 48px;
    flex-shrink: 0;
    padding: 0 10px;
    border-radius: 10px;
    cursor: pointer;
  }

  .row:hover {
    background: rgb(30 30 30 / 0.06);
  }

  /* Selected row = the open conversation (data-active in the app). */
  #v-mara:checked ~ .body label.row[for="v-mara"],
  #v-hermes:checked ~ .body label.row[for="v-hermes"],
  #v-lena:checked ~ .body label.row[for="v-lena"],
  #v-allhands:checked ~ .body label.row[for="v-allhands"],
  #v-scout:checked ~ .body label.row[for="v-scout"],
  #v-eng:checked ~ .body label.row[for="v-eng"],
  #v-clawbits:checked ~ .body label.row[for="v-clawbits"],
  #v-smartclaws:checked ~ .body label.row[for="v-smartclaws"],
  #v-pit:checked ~ .body label.row[for="v-pit"],
  #v-josh:checked ~ .body label.row[for="v-josh"],
  #v-quill:checked ~ .body label.row[for="v-quill"],
  #v-sasha:checked ~ .body label.row[for="v-sasha"] {
    background: rgb(30 30 30 / 0.1);
  }

  /* Opening a chat clears its unread signals, like the real sidebar
   * (badge/dot hidden on the active row). */
  #v-mara:checked ~ .body label.row[for="v-mara"] .row-unread,
  #v-smartclaws:checked ~ .body label.row[for="v-smartclaws"] .row-dot {
    display: none;
  }

  #v-mara:checked ~ .body label.row[for="v-mara"] .row-name,
  #v-smartclaws:checked ~ .body label.row[for="v-smartclaws"] .row-name {
    font-weight: 500;
  }

  #v-allhands:checked ~ .body .j-badge {
    display: none;
  }

  .row-mid {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2px;
    line-height: 1.25;
  }

  .row-name {
    font-size: 13px;
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .row-name.bold {
    font-weight: 600;
  }

  .row-prev {
