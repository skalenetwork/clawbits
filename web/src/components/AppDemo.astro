  /* Channel-with-chatter dot: 8px ink, no count. */
  .rail-dot {
    position: absolute;
    top: -2px;
    right: -2px;
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: rgb(30 30 30 / 0.8);
    box-shadow: 0 0 0 2px var(--bg);
  }

  .rspace {
    flex: 1;
  }

  /* ── Panel card: abuts the rail, 8px inset right, 14px radius ── */
  .main {
    flex: 1;
    min-width: 0;
    display: flex;
    margin: 0 8px 0 0;
    border-radius: 14px;
    border: 1px solid var(--line);
    background: rgb(242 239 232 / 0.82);
    box-shadow:
      0 4px 10px rgb(0 0 0 / 0.1),
      0 1px 2px -1px rgb(0 0 0 / 0.1);
    overflow: hidden;
  }

  /* ── Chats sidebar: 240px ── */
  .side {
    width: 240px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    min-height: 0;
    border-right: 1px solid var(--line);
  }

