  #v-lena:checked ~ .body .view-lena,
  #v-allhands:checked ~ .body .view-allhands,
  #v-scout:checked ~ .body .view-scout,
  #v-eng:checked ~ .body .view-eng,
  #v-clawbits:checked ~ .body .view-clawbits,
  #v-smartclaws:checked ~ .body .view-smartclaws,
  #v-pit:checked ~ .body .view-pit,
