  .l.r::after { rotate: -45deg; }

  /* Minimize: single bar. */
  .l.y::before {
    left: 50%;
    top: 50%;
    width: 7px;
    height: 1.5px;
    border-radius: 1px;
    background: #9a6c00;
    translate: -50% -50%;
  }

  /* Zoom: the two fullscreen triangles. */
  .l.g::before {
    left: 2.5px;
    top: 2.5px;
    width: 4.5px;
    height: 4.5px;
    background: #0b6e0b;
    clip-path: polygon(0 0, 100% 0, 0 100%);
  }

  .l.g::after {
    right: 2.5px;
    bottom: 2.5px;
    width: 4.5px;
    height: 4.5px;
    background: #0b6e0b;
    clip-path: polygon(100% 0, 100% 100%, 0 100%);
  }

  .hist {
    display: inline-flex;
    gap: 2px;
    margin-inline-start: 14px;
    color: var(--mut);
  }

  .hbtn {
    width: 28px;
    height: 28px;
    border-radius: 999px;
    align-items: center;
    justify-content: center;
