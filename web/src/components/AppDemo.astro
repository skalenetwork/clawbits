<script>
  // Seed every conversation ~120px above its latest message, so each one opens
  // on its most recent exchange rather than its oldest. Hidden views keep
  // layout (visibility, not display), so their offsets can be set up front.
  for (const feed of document.querySelectorAll<HTMLElement>(".feed")) {
    const max = feed.scrollHeight - feed.clientHeight;
    if (max > 0) feed.scrollTop = Math.max(0, max - 120);
  }

  // The composer is a single-line field. `white-space: nowrap` handles wrapping
  // but not explicit breaks, so Enter is refused outright and a paste is
  // flattened to one line before it lands.
  for (const field of document.querySelectorAll<HTMLElement>(".comp-text")) {
    field.addEventListener("keydown", (event) => {
      if (event.key === "Enter") event.preventDefault();
    });

    field.addEventListener("paste", (event) => {
      event.preventDefault();
      const flat = (event.clipboardData?.getData("text/plain") ?? "")
        .replace(/\s+/g, " ")
        .trim();
      // execCommand is deprecated but remains the only insertion that keeps
      // the field's native undo stack intact.
      if (flat) document.execCommand("insertText", false, flat);
    });
  }

  // SCROLL HAND-OFF. Chrome latches a wheel gesture to whichever scroller it
  // started on, so a reader who scrolls the chat to its end finds the page
  // frozen until they stop and start again. No CSS fixes it - overscroll-
  // behavior governs the opposite problem - so this does the chaining by
  // hand: at the boundary, cancel the event and move the page instead.
  //
  // Delegated from .win so it costs one listener rather than one per pane,
  // and only fires for wheels that actually landed inside the window.
  const win = document.querySelector<HTMLElement>(".win");

  win?.addEventListener(
    "wheel",
    (event) => {
      // Nearest scrollable ancestor of the pointer, bounded by the window.
      let node: HTMLElement | null = event.target as HTMLElement | null;
      while (node && node !== win) {
        const overflowY = getComputedStyle(node).overflowY;
        if (
          (overflowY === "auto" || overflowY === "scroll") &&
          node.scrollHeight > node.clientHeight
        ) {
          break;
        }
        node = node.parentElement;
      }
      if (!node || node === win) return;

      const atTop = node.scrollTop <= 0;
      const atEnd = node.scrollTop >= node.scrollHeight - node.clientHeight - 1;
      if (!((event.deltaY < 0 && atTop) || (event.deltaY > 0 && atEnd))) return;

      // deltaY is in lines on Firefox and pages on some remotes; window.scrollBy
      // always wants pixels.
      const dy =
        event.deltaMode === 1
          ? event.deltaY * 16
          : event.deltaMode === 2
            ? event.deltaY * window.innerHeight
            : event.deltaY;

      event.preventDefault();
      // `instant`, explicitly: global.css sets `scroll-behavior: smooth` on the
      // root, and a hand-off that animates fights itself - every wheel tick
      // starts a fresh smooth run toward a target measured mid-animation, so
      // the page crawls or stalls. A wheel has to move the page 1:1.
      window.scrollBy({ top: dy, behavior: "instant" });
    },
    // Cancelable, so it cannot be passive.
    { passive: false },
  );
</script>

<style>
  /* ── Real app tokens (frontend/src/index.css, sRGB-converted) ── */
