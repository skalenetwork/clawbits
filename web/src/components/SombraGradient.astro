---
/**
 * The gradient on every rounded canvas: stepped, blurred colour bands rising
 * into one ridge (src/lib/sombra.ts). Painted at 85% so the canvas ground
 * deepens every hue a touch; the rise is a compositor-only transform and stands
 * still under reduced motion.
 *
 * Phones get the same art baked to an opaque image over the canvas ground
 * (`bun run sombra`): mobile WebKit rasterizes SVG filters on the CPU and drops
 * the tiles off screen, so the live svg repainted as a dark box on every scroll
 * back. Portrait canvases pass shape="tall" so the grain is never stretched
 * far. The box is oversized so displaced edges fall outside the canvas clip.
 */
import { sombraSvg, type Palette } from "../lib/sombra";

interface Props {
  palette?: Palette;
  shape?: "tall" | "wide";
}

const { palette = "candy", shape = "wide" } = Astro.props;
---

<div class="sombra" data-palette={palette} data-shape={shape} aria-hidden="true">
  <Fragment set:html={sombraSvg(palette, crypto.randomUUID().slice(0, 8))} />
  <i class="still"></i>
</div>

<style>
  .sombra {
    position: absolute;
    inset: -12px;
    pointer-events: none;
  }

  .sombra > :global(svg),
  .still {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
    transform-origin: 50% 100%;
  }

  .sombra > :global(svg) {
    opacity: 0.85;
  }

  .still {
    display: none;
  }

  @media (max-width: 40rem) {
    .sombra > :global(svg) {
      display: none;
    }

    .still {
      display: block;
      background: url("/sombra/candy-wide.avif") center / 100% 100% no-repeat;
    }

    .sombra[data-palette="sky"] .still {
      background-image: url("/sombra/sky-wide.avif");
    }

    .sombra[data-shape="tall"] .still {
      background-image: url("/sombra/candy-tall.avif");
    }

    .sombra[data-palette="sky"][data-shape="tall"] .still {
      background-image: url("/sombra/sky-tall.avif");
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .sombra > :global(svg),
    .still {
      animation: sombra-rise 1100ms cubic-bezier(0.16, 1, 0.3, 1) both;
    }
  }

  @keyframes sombra-rise {
    from {
      transform: scaleY(0);
    }
  }
</style>
